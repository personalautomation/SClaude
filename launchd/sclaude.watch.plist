<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS's sclaude-watch.timer and sclaude-watch.service in one: asking GitHub
  what QA has done with the features sclaude is waiting on, every five minutes.
  Written into ~/Library/LaunchAgents by install.sh (sclaude/lib/core/launchd.sh),
  with the home, PATH and the log directory put in.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>sclaude.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/sclaude-watch</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
  </dict>
  <!-- The first sweep five minutes after login, as OnBootSec=5min: nothing it
       waits for is in a hurry. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <!-- Nothing here is urgent: the thing it waits for takes hours. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@LOGS@/watch.log</string>
  <key>StandardErrorPath</key>
  <string>@LOGS@/watch.log</string>
</dict>
</plist>
