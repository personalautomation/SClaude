def menu_page(nonce):
    script = """
const tg = window.Telegram && window.Telegram.WebApp;
const $ = (id) => document.getElementById(id);
let busy = false, ctx = '';
// The feature the page was opened on, from its topic: Sclaude, Chrome and
// Code-server stand on it.
// Opened by the Menu button it has none, and the first answer names the one
// it stands on; "📍" changes it.
let home = new URLSearchParams(location.search).get('f') || '';
function button(b) {
  // A caption names the group of buttons under it; it is not pressed.
  if (b.style === 'caption') {
    const c = document.createElement('div'); c.className = 'caption'; c.textContent = b.text;
    return c;
  }
  const el = document.createElement('button');
  el.textContent = b.text;
  // What the button does, under its name, smaller.
  if (b.hint) { const h = document.createElement('small'); h.textContent = b.hint; el.append(h); }
  if (b.style === 'success') el.className = 'ok';
  if (b.style === 'danger') el.className = 'danger';
  if (b.callback_data) el.onclick = () => b.callback_data !== 'noop' && call(b.callback_data, b.text);
  else if (b.url) el.onclick = () => tg.openLink(b.url);
  // The phone preview is a Mini App of the same gate: go there in place.
  else if (b.web_app) el.onclick = () => { location.href = b.web_app.url; };
  return el;
}
// A screen is the chat's message, in Telegram's markup. Telegram keeps a few
// tags and refuses the rest; a page would run whatever came, and a branch
// name or a title from GitHub is in these screens. So only those tags are
// kept, an <a> only with a web or tg: address, and no other attribute of
// anything: no handler, no style.
const KEPT = new Set(['B', 'STRONG', 'I', 'EM', 'U', 'INS', 'S', 'STRIKE', 'DEL',
  'CODE', 'PRE', 'A', 'BR', 'BLOCKQUOTE', 'SPAN']);
function markup(html) {
  const t = document.createElement('template');
  t.innerHTML = html;
  (function clean(node) {
    for (const el of [...node.children]) {
      clean(el);
      if (!KEPT.has(el.tagName)) { el.replaceWith(...el.childNodes); continue; }
      const href = el.tagName === 'A' ? el.getAttribute('href') || '' : '';
      for (const a of [...el.attributes]) el.removeAttribute(a.name);
      if (/^(https?|tg):/i.test(href)) el.setAttribute('href', href);
    }
  })(t.content);
  return t.content;
}
function render(v) {
  document.documentElement.lang = v.lang;
  $('notes').replaceChildren(...v.notes.map((n) => {
    const d = document.createElement('div'); d.className = 'note'; d.append(markup(n)); return d; }));
  if (v.text === null) return;
  ctx = v.context;
  $('text').replaceChildren(markup(v.text));
  $('rows').replaceChildren(...v.rows.map((row) => {
    const r = document.createElement('div'); r.className = 'row';
    r.append(...row.map(button)); return r; }));
  $('time').hidden = !v.time;
  $('help').textContent = v.help || '';
  if (tg.isVersionAtLeast('6.1')) v.main ? tg.BackButton.hide() : tg.BackButton.show();
  window.scrollTo(0, 0);
  if (v.close) setTimeout(() => tg.close(), 1500);
}
function call(action, label) {
  if (busy) return;
  busy = true;
  document.body.classList.add('busy');
  $('err').textContent = '';
  fetch('/__sclaude/menu/api', {method: 'POST', cache: 'no-store',
    body: JSON.stringify({init: tg.initData, do: action, ctx: ctx, label: label || '', home: home})})
    .then((r) => r.ok ? r.json() : Promise.reject(r.status))
    .then((v) => { if (typeof v.home === 'string') home = v.home; render(v);
      if (action && tg.HapticFeedback) tg.HapticFeedback.selectionChanged(); })
    // 403 is almost always a page left open past the day its signature
    // lasts: only the owner gets this far.
    .catch((e) => { $('err').textContent = e === 403
      ? 'This page is out of date: close it and open the menu again.'
      : typeof e === 'number' ? 'The laptop refused (' + e + ').' : 'The laptop did not answer.'; })
    .finally(() => { busy = false; document.body.classList.remove('busy'); });
}
// Links in a screen lead out of the Mini App.
document.addEventListener('click', (e) => {
  const a = e.target.closest('a[href]');
  if (a && tg) { e.preventDefault(); tg.openLink(a.href); }
});
if (!tg || !tg.initData) {
  $('err').textContent = 'Open this from the bot: the Menu button by the input box.';
} else {
  tg.ready();
  tg.expand();
  if (tg.isVersionAtLeast('6.1')) tg.BackButton.onClick(() => call('menu_back'));
  $('time').onsubmit = (e) => { e.preventDefault();
    if ($('hhmm').value) call('until:' + $('hhmm').value, $('hhmm').value); };
  // A card's button in a feature's topic opens the page on that feature.
  const slash = home.indexOf('/');
  call(slash > 0 ? 'topic:' + home.slice(0, slash) + ':' + home.slice(slash + 1) : '');
}
"""
    return ("<!doctype html><html><head><meta charset=utf-8>"
            "<meta name=viewport content='width=device-width,initial-scale=1,viewport-fit=cover'>"
            "<title>Menu</title><style>%s</style></head><body><main>"
            "<p id=err></p><div id=text>…</div>"
            "<form id=time hidden><input id=hhmm type=time required><button>OK</button></form>"
            "<div id=rows></div><div id=notes></div><p id=help></p>"
            "</main>"
            "<script src='https://telegram.org/js/telegram-web-app.js'></script>"
            "<script nonce=%s>%s</script></body></html>" % (MENU_STYLE, nonce, script))


def menu_csp(nonce):
    """What the menu page may load and run: its own script (by nonce) and
    Telegram's, its calls to the gate — and no handler written into markup,
    should one get past markup()."""
    return ("Content-Security-Policy: default-src 'none'; "
            "script-src 'nonce-%s' https://telegram.org; style-src 'unsafe-inline'; "
            "connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'"
            % nonce)


async def gate_own(method, target, headers, reader):
    """A response for the gate's open routes, or None for any other path."""
    url = urlsplit(target)
    if url.path == "/__sclaude/tg":
        # No feature is the list of them all, the bot's first row.
        label = (parse_qs(url.query).get("f") or [""])[0]
        if label and not LABEL.match(label):
            return respond("404 Not Found", page("Not found", "<p>No such feature.</p>"))
        # p: a path of the gate's own to show instead — code-server's.
        path = (parse_qs(url.query).get("p") or [""])[0]
        if path and not (path.startswith(CODE_PREFIX) and GATE_PATH.match(path)):
            return respond("404 Not Found", page("Not found", "<p>No such page.</p>"))
        return respond("200 OK", gate_bootstrap(label, path))
    if url.path == "/__sclaude/menu":
        nonce = secrets.token_urlsafe(18)
        return respond("200 OK", menu_page(nonce), (menu_csp(nonce),))
    if url.path == "/__sclaude/menu/api":
        body = await post_body(method, headers, reader)
        if body is None:
            return respond("400 Bad Request", "")
        return await menu_api(body)
    if url.path == "/__sclaude/tg/auth":
        body = await post_body(method, headers, reader)
        if body is None:
            return respond("400 Bad Request", "")
        if not tg_webapp.verify_init_data(body.decode("utf-8", "replace"),
                                          GATE["token"], GATE["owner"]):
            return respond("403 Forbidden", "")
        return respond("204 No Content", "", (
            "Set-Cookie: " + framed_cookie("%s=%s; Path=/; Max-Age=%d; HttpOnly" % (
                GATE_COOKIE, tg_webapp.sign_cookie(GATE["token"]), tg_webapp.COOKIE_TTL)),))
    return None


# Telegram Web shows a Mini App in a frame inside web.telegram.org, where a
# browser keeps no SameSite=Lax cookie: the gate's own and the product's
# behind it would both be dropped, and every request after the sign-in
# refused. So every cookie on the gate's way is SameSite=None and
# Partitioned: a browser keeps it for the frame, keyed to the site around it
# (web.telegram.org), and does not offer it to any other. What SameSite=Lax
# did against a forged request is done here instead, by cross_site.
COOKIE_ATTRS = ("samesite", "secure", "partitioned")


def framed_cookie(value):
    """A Set-Cookie value that a Mini App inside Telegram Web keeps."""
    parts = [p.strip() for p in value.split(";")]
    kept = [parts[0]] + [p for p in parts[1:]
                         if p and p.split("=", 1)[0].strip().lower() not in COOKIE_ATTRS]
    return "; ".join(kept + ["Secure", "SameSite=None", "Partitioned"])


def cross_site(method, headers):
    """True for a request another site made the browser send: refused, as a
    SameSite=Lax cookie would have kept it out. A plain navigation to a page
    (a link followed, a redirect back from a sign-in) passes, as under Lax.

    Sec-Fetch-Site says where the request came from in every current
    browser; without it, a request that changes something says by Origin."""
    site = headers.get("sec-fetch-site", "")
    if site:
        if site != "cross-site":
            return False
        return not (method in ("GET", "HEAD")
                    and headers.get("sec-fetch-mode", "") == "navigate"
                    and headers.get("sec-fetch-dest", "document") == "document")
    origin = headers.get("origin", "")
    if not origin or method in ("GET", "HEAD"):
        return False
    return urlsplit(origin).netloc != headers.get("host", "")


def frameable(head):
    """A response head with the bans on framing taken out.

    The Mini App shows a feature inside its own frame (the address bar), and
    a product that guards itself against clickjacking — X-Frame-Options, a
    CSP frame-ancestors — would refuse it. Only on the gate's way: the
    product's own headers are unchanged everywhere else, and past the gate
    is only the bot's owner. A Report-Only policy blocks nothing and stays.
    The product's cookies are made ones a frame keeps (framed_cookie)."""
    lines = head.decode("latin-1").split("\r\n")
    out = [lines[0]]
    for line in lines[1:]:
        name, sep, value = line.partition(":")
        key = name.strip().lower()
        if key == "x-frame-options":
            continue
        if key == "set-cookie" and sep:
            line = "%s: %s" % (name, framed_cookie(value.strip()))
        if key == "content-security-policy" and sep:
            kept = [d for d in value.split(";")
                    if d.strip() and not d.strip().lower().startswith("frame-ancestors")]
            if not kept:
                continue
            line = "%s:%s" % (name, ";".join(kept))
        out.append(line)
    return "\r\n".join(out).encode("latin-1")


async def gate_relay(up_reader, writer):
    """The upstream's answer, its head made frameable, then the rest as is."""
    try:
        head = await up_reader.readuntil(b"\r\n\r\n")
    except (asyncio.IncompleteReadError, asyncio.LimitOverrunError, ConnectionError):
        return
    writer.write(frameable(head[:-4]) + b"\r\n\r\n")
    await writer.drain()
    await pipe(up_reader, writer)


async def gate_handle(reader, writer):
    upstream = None
    GATE["open"] += 1
    GATE["last"] = time.time()
    try:
        try:
            head = await asyncio.wait_for(reader.readuntil(b"\r\n\r\n"), 30)
        except (asyncio.IncompleteReadError, asyncio.LimitOverrunError,
                asyncio.TimeoutError, ConnectionError):
            return
        method, target, headers = parse_head(head)
        path = urlsplit(target).path
        # Which path, not what it carried: a query may hold initData. The
        # gate's own paths only: a feature's page and code-server load
        # hundreds of files, which would bury what matters in the journal.
        if path.startswith("/__sclaude/"):
            sys.stderr.write("gate: %s %s\n" % (method, path))
        own = await gate_own(method, target, headers, reader)
        if own is not None:
            writer.write(own)
            await writer.drain()
            return
        if cross_site(method, headers) or not tg_webapp.cookie_valid(
                gate_cookie(headers.get("cookie", "")), GATE["token"]):
            sys.stderr.write("gate: refused %s %s\n" % (method, path))
            writer.write(respond("403 Forbidden", page(
                "Closed", "<h1>Closed</h1><p>Open the feature from the bot: the 📱 "
                "button next to it.</p>")))
            await writer.drain()
            return
        host, port = "127.0.0.1", GATE_UPSTREAM
        if target.startswith(CODE_PREFIX):
            host, port = code_server()
            head = without_prefix(head, CODE_PREFIX)
        try:
            up_reader, upstream = await asyncio.wait_for(
                asyncio.open_connection(host, port), 5)
        except (OSError, asyncio.TimeoutError):
            writer.write(respond("502 Bad Gateway", page(
                "Down", "<h1>sclaude-proxy is not answering</h1>")))
            await writer.drain()
            return
        if headers.get("upgrade", "").lower() != "websocket":
            head = close_after(head)
        upstream.write(head)
        await asyncio.gather(pipe(reader, upstream), gate_relay(up_reader, writer))
    finally:
        GATE["open"] -= 1
        GATE["last"] = time.time()
        for w in (upstream, writer):
            if w is not None:
                try:
                    w.close()
                except (OSError, RuntimeError):
                    pass


# code-server through the gate (an experiment): /__code/… is code-server's
# /…, so a phone without Tailscale reaches it from the Mini App. code-server
# keeps its own password behind the gate's check. Its pages use relative
# addresses throughout, which is what lets it live under a prefix that only
# the gate knows about.
CODE_PREFIX = "/__code/"
CODE_CONFIG = os.environ.get("SCLAUDE_GATE_CODE_CONFIG") or os.path.expanduser(
    "~/.config/code-server/config.yaml")


def code_server():
    """(host, port) code-server listens on, from its config."""
    try:
        with open(CODE_CONFIG) as fh:
            for line in fh:
                if line.strip().startswith("bind-addr:"):
                    host, _, port = line.split(":", 1)[1].strip().rpartition(":")
                    return host, int(port)
    except (OSError, ValueError):
        pass
    return "127.0.0.1", 8080


def without_prefix(head, prefix):
    """The request head with its target moved from under prefix to /."""
    line, sep, rest = head.partition(b"\r\n")
    method, target, version = line.split(b" ", 2)
    target = b"/" + target[len(prefix):]
    return b" ".join((method, target, version)) + sep + rest


async def gate_main():
    env = tg_webapp.read_env(GATE_ENV)
    token = env.get("KEEPAWAKE_BOT_TOKEN", "")
    owner = env.get("KEEPAWAKE_CHAT_ID", "")
    if not token or not owner.lstrip("-").isdigit():
        sys.stderr.write("sclaude-proxy --gate: no KEEPAWAKE_BOT_TOKEN or "
                         "KEEPAWAKE_CHAT_ID in %s\n" % GATE_ENV)
        sys.exit(1)
    GATE.update(token=token, owner=int(owner), last=time.time())
    if os.environ.get("LISTEN_PID") == str(os.getpid()) \
            and int(os.environ.get("LISTEN_FDS") or 0) >= 1:
        # sclaude-gate.socket holds the port; exiting when idle gives it back
        # to systemd, which starts the gate again on the next connection.
        sock = socket.socket(fileno=3)
    else:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        # Loopback only: funnel connects from this machine, and nothing else may.
        sock.bind(("127.0.0.1", GATE_PORT))
        sock.listen(128)
    sock.setblocking(False)
    server = await asyncio.start_server(gate_handle, sock=sock, limit=HEAD_LIMIT)
    tick = min(TICK, max(GATE_IDLE / 4, 0.1))
    async with server:
        while GATE["open"] or time.time() - GATE["last"] < GATE_IDLE:
            await asyncio.sleep(tick)
    sys.stderr.write("sclaude-proxy --gate: nobody looked for %ds; closing\n" % GATE_IDLE)


def listening_socket():
    """systemd's socket when started by sclaude-proxy.socket, else our own."""
    if os.environ.get("LISTEN_PID") == str(os.getpid()) \
            and int(os.environ.get("LISTEN_FDS") or 0) >= 1:
        sock = socket.socket(fileno=3)
        sock.setblocking(False)
        return sock
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind((BIND, PORT))
    sock.listen(128)
    sock.setblocking(False)
    return sock


# The proxy lives for days, and an update of sclaude changes the code it runs
# under it: one started before the state moved into .sclaude/local/feature/
# went on looking in .feature/ and answered "No such feature" for every tree
# made after. So it watches its own file and re-executes when that changes.
# In place, not by exiting: under systemd an exit takes the unit's whole
# cgroup down, every dev server the proxy started with it. The same process
# keeps the socket systemd handed it (fd 3) and its LISTEN_PID.
OWN_FILE = os.path.realpath(__file__)


def own_mtime():
    """The newest of its own file and the library modules it imports."""
    times = []
    for path in (OWN_FILE,) + tuple(os.path.realpath(getattr(m, "__file__", OWN_FILE))
                                    for m in (feature_db, dev_login, dev_login.envs)):
        try:
            times.append(os.stat(path).st_mtime)
        except OSError:
            pass
    return max(times) if times else None


async def watch_own_code(server, started):
    while True:
        await asyncio.sleep(float(os.environ.get("SCLAUDE_PROXY_WATCH") or 10))
        now = own_mtime()
        if now is not None and now != started:
            sys.stderr.write("sclaude-proxy: its code changed; restarting on the new one\n")
            sys.stderr.flush()
            if os.environ.get("LISTEN_PID") == str(os.getpid()):
                os.set_inheritable(3, True)
            else:
                server.close()
            os.execv(sys.executable, [sys.executable, OWN_FILE] + sys.argv[1:])


async def main():
    server = await asyncio.start_server(handle, sock=listening_socket(),
                                        limit=HEAD_LIMIT)
    idle = asyncio.ensure_future(reaper())
    watch = asyncio.ensure_future(watch_own_code(server, own_mtime()))
    try:
        async with server:
            await server.serve_forever()
    finally:
        idle.cancel()
        watch.cancel()


if __name__ == "__main__":
    try:
        asyncio.run(gate_main() if sys.argv[1:2] == ["--gate"] else main())
    except KeyboardInterrupt:
        pass
    except OSError as exc:
        sys.stderr.write("sclaude-proxy: %s\n" % exc)
        sys.exit(1)
