# keepawake's secrets. Copy this to ~/.config/keepawake/env (mode 600) — the
# repository is no place for them: it gets cloned to other machines and ends up
# in backups, and a token that has made it into git history is not revoked by
# simply deleting the file.

# The token: message @BotFather in Telegram, /newbot, copy the string it gives.
KEEPAWAKE_BOT_TOKEN=

# Your own chat_id: send the bot you created any message and open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# the number you need is in message.chat.id. The daemon accepts commands from
# this chat only — a bot is publicly addressable by name, and without the check
# anyone could drive it.
KEEPAWAKE_CHAT_ID=
