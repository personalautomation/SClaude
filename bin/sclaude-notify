#!/usr/bin/env bash
#
# Sends a line to the Telegram chat keepawake already talks to.
#
#   sclaude-notify "regression failed"        with a sound
#   sclaude-notify --quiet "regression started"   silent, sits in the chat
#   echo "..." | sclaude-notify                   the text on stdin
#   sclaude-notify --in <worktree> "..."          to that feature's topic
#   sclaude-notify --in <worktree> --as <name> "..."
#   sclaude-notify --video a.mp4 [--video b.mp4]… "..."   the videos, the text
#                                                 as their caption (an album
#                                                 when there are several)
#   sclaude-notify --ids "..."                    also prints `sent: <id>…`, the
#                                                 ids of what went, on stdout
#   sclaude-notify --delete <id> [--delete <id>]… those messages deleted from
#                                                 the chat (no text); exit 1,
#                                                 `not deleted: <id>…` on
#                                                 stderr, when any stayed or no
#                                                 bot is set up
#
# With --in the message goes to the feature's topic (the thread in its
# worktree's .sclaude/local/feature/telegram.json, which the bot keeps), so a
# feature's regression is told where its questions are; the main chat when the
# feature has no topic, or the topic has gone. --as names what the message is
# about, and is said only there: "<name>: " goes before it in the main chat,
# where features share one place, and nowhere in the topic, which is the
# feature already.
#
# One exception, while the bot's widgets are on (⚙️ Settings → 🧩 Sending)
# and the bot is running: a phase line for a feature's topic ("🧪 Regression
# started", its end) is not sent but written into the feature's feed
# (notes/feed.tsv, as ask_feed writes it), so the regression's widget in the
# topic takes it (keepawake/processes.py). A line that would sound is written
# at the level "ring", which sounds without a warning's mark; the person at
# the terminal that asked keeps it silent, as every feed line. With the bot
# down, or widgets off, the line is sent here as before.
#
# Why a separate sender rather than the daemon: keepawake-telegram is a long
# poll that owns getUpdates, and a regression run has no business waking it.
# This is a one-shot HTTP request with the same token, and it exits.
#
# The credentials come from ~/.config/keepawake/env, which this script parses
# itself. The daemon does not: systemd hands it the file through
# EnvironmentFile=, so telegramd's load_env() reads the process environment and
# would find nothing here — a regression runs from a terminal and from a timer,
# where nobody has loaded that file.
#
# A missing or empty token is not an error. A notification must never be the
# reason a regression fails, so a message stays silent and exits zero (--delete
# does not: its caller keeps what stayed, to try again) — the run's
# own summary is already on the terminal, and the message is the extra.
set -uo pipefail

ENV_FILE="$HOME/.config/keepawake/env"

quiet="" feature="" name="" videos="" ids="" deletes=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --quiet) quiet=1; shift ;;
    # Last with no value, shift 2 would shift nothing and loop for ever.
    --in) feature="${2:-}"; shift; [[ $# -gt 0 ]] && shift ;;
    --as) name="${2:-}"; shift; [[ $# -gt 0 ]] && shift ;;
    --video) [[ -f "${2:-}" ]] && videos+="${2}"$'\n'; shift; [[ $# -gt 0 ]] && shift ;;
    --ids) ids=1; shift ;;
    --delete) [[ "${2:-}" =~ ^[0-9]+$ ]] && deletes+="${2} "; shift; [[ $# -gt 0 ]] && shift ;;
    *) break ;;
  esac
done

# Deleting takes no text: stdin is not read for one.
if [[ -n "$deletes" ]]; then
  text="-"
# The text: arguments if there are any, otherwise stdin. The pipe form is what
# a regression summary uses — it is already several lines by the time it gets
# here, and passing it as one argument would mean quoting it twice.
elif [[ $# -gt 0 ]]; then
  text="$*"
else
  text="$(cat)"
fi
[[ -n "${text//[[:space:]]/}" ]] || exit 0

# A delete that cannot be made is said with exit 1: its caller keeps the ids
# to try again, where a notification that cannot go is only the extra.
nothing() { [[ -n "$deletes" ]] && exit 1; exit 0; }

[[ -f "$ENV_FILE" ]] || nothing

# Only the two names we need, and only the value after the first `=`: the token
# contains a colon and the chat id may be negative, so nothing here may split on
# anything else. `export` is not accepted because systemd's EnvironmentFile does
# not accept it either — the file has one format, not two.
token="$(sed -n 's/^KEEPAWAKE_BOT_TOKEN=//p' "$ENV_FILE" 2>/dev/null | head -1)"
chat="$(sed -n 's/^KEEPAWAKE_CHAT_ID=//p' "$ENV_FILE" 2>/dev/null | head -1)"
token="${token%\"}"; token="${token#\"}"
chat="${chat%\"}"; chat="${chat#\"}"
[[ -n "$token" && -n "$chat" ]] || nothing

# A heredoc rather than python3 -c: an apostrophe inside a single-quoted -c
# block closes the string and breaks the script, and the comments below have
# several.
#
# A failed send does not fail the run — that is the header's promise — but it
# does say so on stderr. The two are not the same thing: no token is a machine
# that was never set up, while a rejected request is a message that was meant to
# arrive and did not, and swallowing that in silence is how a regression summary
# disappears without anybody learning it was ever sent. Standard library only —
# this runs on a machine where nothing was installed for it.
# The checkout this script lives in, through the link in ~/.local/bin: the
# bot's record of a topic is named by its code, which is imported from there.
root="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
python3 - "$token" "$chat" "$text" "${quiet:-}" "$feature" "$root" "$name" "$videos" "$ids" "$deletes" "$PPID" <<'PY' || nothing
import html
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

token, chat, text, quiet, feature, root, name = sys.argv[1:8]
videos = [v for v in sys.argv[8].split("\n") if v] if len(sys.argv) > 8 else []
print_ids = len(sys.argv) > 9 and sys.argv[9] == "1"
deletes = [int(d) for d in sys.argv[10].split()] if len(sys.argv) > 10 else []
caller = sys.argv[11] if len(sys.argv) > 11 else "0"

# The feature's topic, when it has one: the bot keeps its id in the worktree.
thread = 0
if feature:
    try:
        with open(feature + "/.sclaude/local/feature/telegram.json") as fh:
            thread = int((json.load(fh) or {}).get("thread") or 0)
    except (OSError, ValueError, TypeError):
        thread = 0

# Everything is escaped, and formatting is applied here rather than accepted
# from the caller. What comes through this script is test output: names like
# "expected a < b" and "<Foo> renders" are ordinary there, and to the Bot API
# they are unsupported tags — the request comes back 400 and the message is
# lost. The caller cannot be trusted to remember that, because the caller is a
# regression run splicing in whatever a test was called.
#
# The first line is made bold instead: a summary wants a heading, that is all
# the markup ever needed here, and it is applied after escaping so the escape
# cannot eat it.
def markup(text):
    lines = html.escape(text).split("\n")
    return "\n".join(["<b>%s</b>" % lines[0]] + lines[1:])


body = markup(text)

# The string "true" rather than Python's True: urlencode prints a bool
# capitalised, and while the Bot API accepts that, the documented form is lower
# case. When a sound is wanted the parameter is left out altogether.
params = {"chat_id": chat, "text": body, "parse_mode": "HTML"}
if quiet:
    params["disable_notification"] = "true"

url = "https://api.telegram.org/bot%s/sendMessage" % token


def multipart(fields, files):
    """A multipart/form-data body: (content type, bytes)."""
    edge = "sclaude%s" % os.urandom(8).hex()
    out = []
    for key, value in fields.items():
        out.append(("--%s\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n%s\r\n"
                    % (edge, key, value)).encode())
    for key, path in files.items():
        with open(path, "rb") as fh:
            data = fh.read()
        out.append(("--%s\r\nContent-Disposition: form-data; name=\"%s\"; filename=\"%s\"\r\n"
                    "Content-Type: video/mp4\r\n\r\n" % (edge, key, os.path.basename(path))).encode()
                   + data + b"\r\n")
    out.append(("--%s--\r\n" % edge).encode())
    return "multipart/form-data; boundary=" + edge, b"".join(out)


def send(params, raw):
    """sendMessage — or, with videos, the videos with `raw`, the same text
    unescaped, as their caption: one by sendVideo, several as an album by
    sendMediaGroup (ten at most)."""
    if not videos:
        req = urllib.request.Request(url, data=urllib.parse.urlencode(params).encode())
    else:
        fields = {k: v for k, v in params.items() if k not in ("text", "parse_mode")}
        files = {"v%d" % i: v for i, v in enumerate(videos[:10])}
        # A caption holds 1024 characters: the text is cut before it is
        # escaped, so the cut never falls inside an entity or a tag.
        caption = markup(raw[:900])
        if len(files) == 1:
            method = "sendVideo"
            fields.update(video="attach://v0", caption=caption,
                          parse_mode="HTML", supports_streaming="true")
        else:
            method = "sendMediaGroup"
            fields["media"] = json.dumps([dict(
                {"type": "video", "media": "attach://" + k, "supports_streaming": True},
                **({"caption": caption, "parse_mode": "HTML"} if i == 0 else {}))
                for i, k in enumerate(files)])
        kind, data = multipart(fields, files)
        req = urllib.request.Request(url.rsplit("/", 1)[0] + "/" + method, data=data,
                                     headers={"Content-Type": kind})
    with urllib.request.urlopen(req, timeout=120 if videos else 15) as resp:
        return json.load(resp)


def message_ids(out):
    """The ids of the messages Telegram's answer says went: one, or an
    album's every video."""
    sent = (out or {}).get("result")
    return [int(m["message_id"]) for m in (sent if isinstance(sent, list) else [sent or {}])
            if isinstance(m, dict) and str(m.get("message_id", "")).isdigit()]


def call(method, **fields):
    req = urllib.request.Request(url.rsplit("/", 1)[0] + "/" + method,
                                 data=urllib.parse.urlencode(fields).encode())
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.load(resp)


# deleteMessage's refusals that no later try changes: the message is gone
# already, or Telegram will not delete it (older than 48 hours for a bot that
# is no admin, or an id that names no message) — left in the chat, said, and
# not kept to try again.
GONE = b"message to delete not found"
FINAL = (b"message can't be deleted", b"message_id_invalid")


def delete():
    """--delete: the messages taken out of the chat — deleteMessages a
    hundred at a time, and a batch it refuses (a 400) one by one, so that
    one message too old to delete keeps none of the others. Another 400
    about one message keeps that one to try again and goes on. A failure
    that is not about the message — the network, a rate limit, a server
    error, a 400 about the chat (not found, no rights in it) — stops every
    call after it: what is left stays, to be tried with the next demo, since
    more calls would fail the same way and only lengthen a rate limit.
    Exit 1 when any stayed, their ids on stderr after `not deleted:`
    (demo.py's STAYED)."""
    stayed, left = [], []
    for i in range(0, len(deletes), 100):
        batch = deletes[i:i + 100]
        try:
            call("deleteMessages", chat_id=chat, message_ids=json.dumps(batch))
            continue
        except urllib.error.HTTPError as exc:
            if exc.code != 400:
                stayed += deletes[i:]
                break
        except Exception:
            stayed += deletes[i:]
            break
        stop = False
        for k, one in enumerate(batch):
            try:
                call("deleteMessage", chat_id=chat, message_id=one)
                continue
            except urllib.error.HTTPError as exc:
                why = exc.read().lower() if exc.code == 400 else b""
            except Exception:
                why = b""
            if any(w in why for w in FINAL):
                left.append(one)
            elif GONE in why:
                pass
            elif why and b"chat" not in why:
                stayed.append(one)
            else:
                stayed += deletes[i + k:]
                stop = True
                break
        if stop:
            break
    if left:
        # Its last words are what demo.py reads (LEFT in skills/sdemo).
        sys.stderr.write("sclaude-notify: left in the chat, Telegram will not delete them: %s\n"
                         % " ".join(map(str, left)))
    if stayed:
        sys.stderr.write("sclaude-notify: not deleted: %s\n" % " ".join(map(str, stayed)))
        sys.exit(1)


if deletes:
    delete()
    sys.exit(0)


def bot_running():
    """Whether the bot that reads the feed is up: otherwise a line written
    there would wait, and go after an hour unsent."""
    said = os.environ.get("KEEPAWAKE_BOT_ALIVE")
    if said is not None:
        return said == "1"
    import subprocess
    from keepawake.state import BOT_UNIT
    try:
        return subprocess.run(["systemctl", "--user", "is-active", "--quiet", BOT_UNIT],
                              timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def into_feed():
    """A phase line to a feature's topic ("🧪 Regression started", its end)
    while the bot's widgets are on: written into the feature's feed
    (notes/feed.tsv, as ask_feed in sclaude/lib/core/io.sh writes it) rather
    than sent, so the process's widget takes it (keepawake/processes.py).
    Whether it went there; anything else is sent as before."""
    if not (feature and thread) or videos or print_ids:
        return False
    try:
        sys.path.insert(0, root)
        from keepawake import notices, widgets
        # The bus last: most lines are not phase lines, and asking systemd
        # costs a process.
        if not widgets.enabled() or not notices.OWN_ICON.match(text.strip()) or not bot_running():
            return False
        with open(feature + "/.sclaude/local/feature/state.json") as fh:
            slug = (json.load(fh) or {}).get("feature") or ""
        # The repository's git directory, where the channels are: a
        # worktree's .git file names it (gitdir: <repo>/.git/worktrees/<x>).
        dot = os.path.join(feature, ".git")
        if os.path.isdir(dot):
            common = dot
        else:
            with open(dot) as fh:
                gitdir = fh.read().split("gitdir:", 1)[1].strip()
            common = os.path.dirname(os.path.dirname(gitdir))
        channel = os.path.join(common, "sclaude", "ask", slug)
        if not slug or not os.path.isdir(channel) or os.path.exists(os.path.join(channel, "ended")):
            return False
        os.makedirs(os.path.join(channel, notices.NOTES_DIR), exist_ok=True)
        level = "info" if quiet else "ring"
        import time
        with open(os.path.join(channel, notices.NOTES_DIR, notices.FEED_FILE), "a") as fh:
            for line in text.splitlines():
                if line.strip():
                    fh.write("%d\t%s\t%s\t%s\n" % (time.time(), level, caller, line.replace("\t", " ")))
        return True
    except Exception:
        return False


if into_feed():
    sys.exit(0)


def deliver():
    """The message to the feature's topic, or to the main chat when it has
    none or the topic is gone; Telegram's answer."""
    if thread:
        # A topic gone — deleted by hand, or topics turned off — answers 400
        # in the words TOPIC_GONE in keepawake/topics.py lists: the main
        # chat then. Any other refusal — a rate limit, a server error — is
        # not a lost topic, and the message is not moved for it.
        gone = (b"thread not found", b"topic_id_invalid", b"topic_deleted", b"not a forum")
        try:
            out = send(dict(params, message_thread_id=thread), text)
            # Into the bot's record of the topic, which it deletes with the
            # topic: a deleted topic leaves its messages in the chat's "All"
            # view. The path is the bot's own (keepawake/state.py).
            try:
                sys.path.insert(0, root)
                from keepawake.state import topic_ledger
                ledger = topic_ledger(thread)
                os.makedirs(os.path.dirname(ledger), exist_ok=True)
                with open(ledger, "a") as fh:
                    for one in message_ids(out):
                        fh.write("%d\n" % one)
            except Exception:
                pass
            return out
        except urllib.error.HTTPError as exc:
            refused = exc.read()
            if exc.code != 400 or not any(w in refused.lower() for w in gone):
                # Read once already; the report below reads it again.
                exc.read = lambda: refused
                raise
    # The main chat, where the name says which feature this is about.
    raw = "%s: %s" % (name, text) if name else text
    return send(dict(params, text=markup(raw)), raw)


try:
    try:
        out = deliver()
    except urllib.error.URLError as exc:
        # The videos are the extra: when Telegram certainly did not take
        # them, the text goes the same way as an ordinary message, so its
        # links still arrive. Certainly: a 4xx refusal (but 429, a rate limit
        # the text would meet too), or a failure while the request was still
        # going out — urllib wraps those in URLError. A 5xx, or a timeout
        # waiting for the answer (a bare TimeoutError, not caught here), may
        # come after Telegram posted the album, and the links would arrive
        # twice.
        code = getattr(exc, "code", None)
        if not videos or (code is not None and not (400 <= code < 500 and code != 429)):
            raise
        why = ""
        if code is not None:
            try:
                why = json.loads(exc.read().decode()).get("description", "")
            except Exception:
                why = ""
        videos = []
        out = deliver()
        # Its last words are what demo.py reads (TEXT_ONLY in skills/sdemo).
        sys.stderr.write("sclaude-notify: the videos did not go (%s); the text did\n"
                         % (why or ("HTTP %d" % code if code else str(exc.reason))))
    if not out.get("ok"):
        sys.stderr.write("sclaude-notify: telegram refused: %s\n"
                         % out.get("description", "no reason given"))
        sys.exit(1)
    # What a caller that takes the message back later keeps (demo.py's SENT).
    if print_ids:
        print("sent: " + " ".join(map(str, message_ids(out))))
except Exception as exc:
    detail = ""
    if hasattr(exc, "read"):
        try:
            detail = json.loads(exc.read().decode()).get("description", "")
        except Exception:
            detail = ""
    sys.stderr.write("sclaude-notify: did not send: %s%s\n"
                     % (type(exc).__name__, ": " + detail if detail else ""))
    sys.exit(1)
PY
