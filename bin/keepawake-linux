#!/usr/bin/env python3
#
# The holding side of keepawake on a plain Linux machine — what KeepAwake.ps1 is
# on Windows, and keepawake-macos on a Mac.
#
# bin/keepawake decides; this executes. The loop is keepawake/hold_loop.py,
# shared with macOS: every 30 seconds it reads the state file and, while the
# answer is yes, this keeps a `systemd-inhibit` lock: on sleep, idle and the lid
# switch where logind allows it, on idle alone where it does not (see WHAT
# below). When the answer turns to no, or the state goes stale, the lock is
# dropped and the machine sleeps by its own rules again.
#
#   keepawake-linux          run the loop (what keepawake-linux.service calls)
#
# Run by systemd as a user service; one instance at a time.
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from keepawake import hold_loop  # noqa: E402

# What is held, most first. logind's default polkit policy grants blocking
# sleep and the lid switch only to a process inside a login session
# (allow_any=no), and a user service under linger is in none — so as installed
# it is refused both and gets idle alone, which still stops the idle timer from
# suspending the machine under remote work but not a closed lid or an explicit
# suspend. The polkit rule in the README grants the rest; with it the full set
# is taken. Holding something beats holding nothing because one part was
# refused.
WHAT = ("sleep:idle:handle-lid-switch", "sleep:idle", "idle")


def inhibit_command(what):
    # KEEPAWAKE_INHIBIT is for the tests: a stand-in that behaves like the lock
    # without asking logind for anything.
    override = os.environ.get("KEEPAWAKE_INHIBIT")
    if override:
        return [override, what]
    return ["systemd-inhibit", "--what=" + what, "--who=keepawake",
            "--why=work in progress (keepawake)", "--mode=block",
            "sleep", "infinity"]


class Holder(hold_loop.Holder):
    """A systemd-inhibit child that holds the lock while it lives."""

    refused = "systemd-inhibit refused every lock (%s)" % ", ".join(WHAT)

    def __init__(self):
        super().__init__()
        self.child = None
        self.what = None

    def holding(self):
        return self.child is not None and self.child.poll() is None

    def held(self):
        return self.child is not None

    def partial(self):
        if self.what == WHAT[0]:
            return None
        return ("logind granted only '%s'; a closed lid or an explicit suspend "
                "still sleeps. The polkit rule in the README grants the rest." % self.what)

    def acquire(self):
        self.what = None
        for what in WHAT:
            try:
                child = subprocess.Popen(inhibit_command(what),
                                         stdin=subprocess.DEVNULL,
                                         stdout=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL,
                                         start_new_session=True)
            except OSError:
                continue
            # A refusal from logind ends the process at once; a granted lock
            # keeps it waiting on `sleep infinity`.
            time.sleep(1)
            if child.poll() is None:
                self.child = child
                self.what = what
                return True
        return False

    def release(self):
        if self.child is None:
            return
        try:
            os.killpg(self.child.pid, signal.SIGTERM)
        except OSError:
            pass
        try:
            self.child.wait(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(self.child.pid, signal.SIGKILL)
            except OSError:
                pass
        self.child = None


def main():
    # Stopping the service drops the lock: the loop releases it on SIGTERM, and
    # the systemd-inhibit it started is in its own process group, which it kills.
    return hold_loop.run(Holder(), "keepawake-linux", ".linux-hold.lock")


if __name__ == "__main__":
    sys.exit(main())
