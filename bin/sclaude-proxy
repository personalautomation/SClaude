font:15px/1.4 system-ui,sans-serif;color:var(--tg-theme-text-color,#1c1917)}
main{padding:12px 16px 24px;
padding-top:calc(12px + var(--tg-safe-area-inset-top,0px) + var(--tg-content-safe-area-inset-top,0px))}
#text,.note{white-space:pre-wrap;overflow-wrap:anywhere}
#text pre,.note pre{white-space:pre-wrap;overflow-wrap:anywhere}
.caption{font-size:13px;color:var(--tg-theme-hint-color,#78716c);margin-top:6px}
button small{display:block;font-size:12px;opacity:.8;margin-top:2px}
a{color:var(--tg-theme-link-color,#2563eb)}
.note{background:var(--tg-theme-secondary-bg-color,#f5f5f4);border-radius:12px;
padding:12px;margin:12px 0}
#rows{display:flex;flex-direction:column;gap:8px;margin-top:16px}
.row{display:flex;gap:8px}
.row button{flex:1;min-width:0}
button{border:0;border-radius:10px;padding:10px 6px;font:inherit;
background:var(--tg-theme-button-color,#2563eb);color:var(--tg-theme-button-text-color,#fff)}
button.ok{background:#16a34a;color:#fff}
button.danger{background:#dc2626;color:#fff}
body.busy button{opacity:.5;pointer-events:none}
