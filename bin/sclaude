#!/usr/bin/env bash
#
# sclaude — the orchestrator of a feature's development cycle on top of claude.
#
# A feature's cycle is four steps, each with its own model, permissions and
# prompt:
#
#   1. plan    opus   / high   / plan   — context, scope, the plan in
#                                         .sclaude/local/feature/plan.md
#   2. code    opus   / medium / auto   — implementation, testing, commits
#   3. pr      sonnet / medium / auto   — the manuals, the PR body, gh pr create
#   4. review  opus   / medium / auto   — fixing review comments, preview deploy
#
# Context is not carried between steps: every step is a new session, and
# .sclaude/local/feature/plan.md serves as the bridge. The orchestrator writes it, from the
# plan approved in step 1's session: the step itself is in plan mode, and that
# forbids writing. Returning to an unfinished step goes through --resume, so an
# interrupted conversation is not lost.
#
# Step 1 does not begin with the plan: first the issue with all its links and the
# manual sections that are needed, then a guess about the scope — and a stop,
# until the human corrects it. Planning around an unconfirmed guess means redoing
# the whole plan afterwards.
#
# An issue is created in GitHub for a feature started from a name too: sclaude
# asks about that at the very beginning and sets everything that is known without
# a conversation — the title, the assignee, the label, the type, the milestone.
# The "User request" is driven by step 1, in a comment of its own: what the
# human wants is known only from talking to them, and the description is never
# edited after it is created.
#
# Step 1 is closed not by a question but by the plan's approval, and development
# begins right after the exit. Changing one's mind after that is `replan`: it
# returns the feature to planning, but as a new conversation rather than a
# continuation of the old one.
#
#   sclaude                 the menu: active features, chosen with arrow keys
#   sclaude new [name]      start a feature at step 1
#   sclaude <name>          continue a feature from its current step
#   sclaude status          a table of every feature and its step
#   sclaude actions [name]  every action on one feature in a single list
#   sclaude dev [name]      start the dev server (without a name, for the
#                           current directory); it opens at
#                           http://<name>.localhost:3000
#   sclaude sync <name>     merge origin/main into a feature's branch
#   sclaude news <name>     what has changed on the pull request
#   sclaude preview <name>  ship the branch to preview
#   sclaude rollback <name> put production back to the release before this
#                           feature
#   sclaude issue <name>    create a GitHub issue for a feature that has none
#   sclaude replan <name>   return a feature to step 1 and plan it afresh
#   sclaude return <name> [reason]  send a finished feature back to step 4
#   sclaude done <name>     clean up after the merge (the worktree and branches)
#   sclaude drop <name>     abandon a feature: remove its traces here and on
#                           GitHub
#   sclaude regression <name> [prod]
#                           run the checks a step closes on, or production's
#   sclaude friction <name> review what got in a step's way and customise
#                           sclaude for the product
#   sclaude deferred        the monthly review of the friction put off
#   sclaude propose         send a change to sclaude itself as a pull request
#   sclaude workshop        a session that changes sclaude with you, in a
#                           worktree of its own (the bot's 🛠 button)
#   sclaude update          take sclaude's main now (sclaude.update says
#                           whether a start does it by itself)
#   sclaude core-send       send the tree's workshop change you held back
#   sclaude core-open       run by a session: open the tree's workshop, where
#                           it may change sclaude (workshop.sh)
#   sclaude core-ready [--review "<how>"]
#                           run by a session: its change there is reviewed,
#                           and is published when the session ends
#   sclaude review-stats    what this product's review sessions cost in context
#   sclaude review-report <name>
#                           whether the review is still worth it: rounds,
#                           findings, fixes, back and forth, cost
#   sclaude checks [pr]     step 4's wait after a push: the review check of
#                           the pushed commit, then every check finished
#   sclaude reset <name>    start the current step afresh, forgetting its
#                           conversation
#   sclaude epilogue [name] append the status to the issue if the epilogue was
#                           interrupted
#   sclaude doctor          what this machine has and lacks, and how to fix it
#
# All of this is also a list, behind the checkbox in the menu: choosing a feature
# with the checkbox set gives the human those same actions in one list without
# their having to remember command names.
#
# Every feature's state is .sclaude/local/feature/state.json in its worktree.
# The directory is a working one: sclaude hides it from git, it is never
# committed, and it goes with the worktree.
#
# Every session that is started writes its id there BEFORE launching — both a
# step and the friction review. Otherwise an interrupted session is lost: there
# is nothing to return to it by, and what was begun has to be done again. There
# is no place there for the epilogue — by its minute the feature's tree has been
# removed — and it writes its own into ~/.claude/sclaude/epilogue/, outside the
# repositories altogether. The menu offers to finish an unclosed one itself, next
# to the branch review: a closed feature has left the list, and there will be no
# other occasion to remember it.
#
# Anything at all can interrupt a session: a limit, a closed terminal, Ctrl-C. So
# none of them counts as an answer: a step is closed by a trace in the world (an
# approved plan, a PR number, a merged PR) rather than by a process that has
# ended. If the review did not take place, the next step waits for it rather than
# travelling ahead with the old orchestrator. And when there is nowhere to return
# to — the transcript is damaged, the session hangs open, the step does not
# survive to a conversation — `reset` erases the launch's trace without touching
# the work.
set -uo pipefail

# --- the environment ---------------------------------------------------------

SELF="$(basename "$0")"
PROMPTS="$(cd "$(dirname "$(readlink -f "$0")")/../sclaude/prompts" && pwd)"
HOOKS="$(cd "$(dirname "$(readlink -f "$0")")/../sclaude/hooks" && pwd)"
LIB="$(cd "$(dirname "$(readlink -f "$0")")/../sclaude/lib" && pwd)"
# The tool's own root: that is where the friction review session makes its edits
# — the orchestrator rather than the product. Through readlink, because sclaude
# is called by a symlink.
INSTRUMENTS="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# The orchestrator's body is spread across modules: bin/sclaude holds the
# environment, the commands and the argument parsing, and everything else lies in
# sclaude/lib and is pulled in here.
#
# It is not a matter of readability alone. The friction review session edits this
# very file while it is executing, and bash reads a script lazily, by offset into
# an open descriptor: an edit in place shifts everything the process has not read
# yet. That is how the log tidying went missing after the `code` step of the
# password-change feature, and on this revision a ready fix waited four hours for
# the end of somebody else's step. A module pulled in with source is read whole
# at that moment, so editing it is no longer dangerous to a running process, and
# bin/sclaude itself became four times shorter — the window narrowed by as
# much.
#
# The order of the sources does not matter: the files only declare functions
# without executing anything. A read error on any of them is death on the spot:
# half an orchestrator is worse than none.
for _module in core/io core/ui core/steps core/state core/project core/environment core/developer \
               tree/branches tree/worktree tree/featuredb core/lock core/pane cycle/run \
               cycle/prompt cycle/session_watch cycle/acceptance review/review_round \
               review/review_gate improve/friction improve/instruments github/github \
               github/issue_sync github/board github/outcome cycle/plan ship/deploy ship/shipped \
               ship/vercel ship/qa ship/merge ship/demo ship/regression ship/regression_gate \
               ship/regression_fix ship/rollback cycle/watch core/picker commands/abandon \
               commands/actions commands/doctor improve/deferred core/terminal improve/retro \
               core/scratch cycle/no_change review/local_review core/config tree/sync \
               improve/workshop improve/workbench commands/start commands/menu commands/step_commands commands/done \
               commands/feature_commands; do
  # shellcheck source=/dev/null
  source "$LIB/$_module.sh" || {
    echo "sclaude: cannot load $LIB/$_module.sh" >&2
    exit 1
  }
done
unset _module
# What was loaded just now, to notice when it changes under a long session.
SCLAUDE_CODE="$(code_fingerprint)"

# Everything below, bash is obliged to read to the end before it executes a
# single command from here: it finds a compound command's closing brace by
# parsing, not by executing. That is exactly what the braces are for — not
# grouping but the moment of reading.
#
# Without them the last lazily-read piece was left, the most dangerous one: bash
# finishes reading `main` and its `case` at the end of a session, that is their
# offset in the descriptor waits for an edit longer than anything else. The
# `review` step's session on one feature died of exactly
# that — the file grew by three lines, the offset stayed where it was, and
# `cmd_replan` was read as `replan`:
#
#   line 543: syntax error near unexpected token `;;'
#
# The braces do not spawn a subshell, so exit, variables and set see exactly what
# they saw before.
{

# Colours only when the output really goes to a terminal: sclaude status | grep
# must not receive escape sequences.
if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'
  YELLOW=$'\033[33m'; BLUE=$'\033[34m'; OFF=$'\033[0m'
else
  BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''; BLUE=''; OFF=''
fi

# These print to the screen and accumulate what was printed for the next
# question: a question shown in a messenger arrives there without the lines that
# stand right above it in the terminal — and without them "Publish?" is agreement
# to who knows what. ask_note (io.sh) accumulates, and the next ask clears it.
# This does not affect the terminal: the lines are printed as they always
# were. ask_feed (io.sh) also hands them to the feature's topic.
die()  { echo "${RED}$*${OFF}" >&2; exit 1; }
warn() { ask_note "$*"; ask_feed warn "$*"; echo "${YELLOW}$*${OFF}" >&2; }
# Red rather than yellow: not a caution but an exception to the flow itself —
# something that should not have happened and that the human must notice.
alarm() { ask_note "$*"; ask_feed alarm "$*"; echo "${RED}$*${OFF}" >&2; }
info() { ask_note "$*"; ask_feed info "$*"; echo "${DIM}$*${OFF}"; }

# Printing without formatting but with remembering — for what the human must see
# next to the question. A plain echo will not do for that: it puts nothing into
# the buffer, and the question arrives on the phone bare.
#
# The difference is expensive. `run_block` prints the list of commands that will
# run this way — without it the "Publish?" button is agreement to who knows what.
# `cmd_menu` prints the feature list this way, and without it the choice buttons
# arrive as the unlabelled digits "1 2 3 4".
say() { ask_note "$*"; ask_feed say "$*"; echo "$*"; }

usage() {
  cat <<EOF
${BOLD}$SELF${OFF} — an orchestrator for the feature development cycle

  $SELF                 menu: features in progress, arrows to choose
  $SELF new [name]      start a feature at step 1 (planning)
  $SELF <name>          continue a feature from its current step
  $SELF status          a table of every feature and its step
  $SELF doctor          what this machine has and lacks, with the fix for each gap
  $SELF config          the project's .sclaude/config.json, each section explained; sets the review mode
  $SELF dev [name]      start the dev server (no name — for the current directory)
  $SELF dev --stop [name]  stop the dev server of a feature (or of this directory)
  $SELF actions [name]  every action for one feature, in one list
  $SELF sync <name>     merge origin/main into the feature's branch
  $SELF news <name>     what has moved on the pull request
  $SELF preview <name>  deploy this branch to a preview URL
  $SELF rollback <name> put production back to the release before this feature
  $SELF issue <name>    create a GitHub issue for a feature that has none
  $SELF replan <name>   take a feature back to step 1 and plan it again
  $SELF return <name> [reason]  send a finished feature back to development
                        (step 4): its session reads what was said since, on
                        the issue and on the pull request
  $SELF done <name>     remove the worktree and branches after the merge
  $SELF drop <name>     abandon a feature: clear its traces here and on GitHub
  $SELF regression <name> run the checks step 2 and step 4 close on
  $SELF regression <name> prod   production's suite again; green lifts a hold
  $SELF friction <name> review what got in the step's way and fix the tooling
  $SELF deferred        the monthly review of the friction put off (offered by itself)
  $SELF review-stats    what review sessions cost in context, to set the threshold
                        at which a round goes to a fresh session
  $SELF review-report <name>
                        rounds, findings fixed and closed without a fix, back and
                        forth, cost and trend: is the review still worth it
  $SELF checks [pr]     wait after a push until the review check of the pushed
                        commit has appeared and every check has finished, each
                        wait bounded; the exit code says how it ended
  $SELF reset <name>    start the current step over, forgetting its conversation
  $SELF epilogue [name] write the status into the issue if the epilogue broke off
                        (the menu offers this by itself; the command is for a
                        named feature, or to list what is waiting)

In the menu, tick 'show actions after choosing' to get all of the above for
one feature in a single list, instead of remembering the command names.

Steps: $(printf '%s → ' "${STEPS[@]}" | sed 's/ → $//')

The orchestrator runs the dev server, not the claude session: a \`next dev\`
started from inside a session stays in its process group and keeps you from
leaving it — and leaving is how a step ends.
EOF
}

main() {
  # This machine's settings moved from ~/.config/instruments/ to
  # ~/.config/sclaude/ with the repository's name; an older install's are moved
  # once rather than lost (projects, metrics-remote, the polkit mark).
  local old_config="${XDG_CONFIG_HOME:-$HOME/.config}/instruments"
  [[ -d "$old_config" && ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/sclaude" ]] \
    && mv "$old_config" "${XDG_CONFIG_HOME:-$HOME/.config}/sclaude"

  # We open the question-answer channel only where a conversation is possible at
  # all.
  #
  # Conversational commands and informational ones are outwardly
  # indistinguishable — either may have no terminal — while the difference is
  # fundamental: a question in the channel waits for an answer for as long as it
  # takes. For `status` that would be a disaster: the bot calls it with a
  # 25-second timeout to draw the feature list, and a hanging question would hang
  # the whole Sclaude section along with it.
  #
  # The directory is the main repository's .git/sclaude/, one for the whole cycle
  # and all the worktrees. It is also the only one: a question is found even
  # before the feature is created, and the bot looks exactly here without knowing
  # about its tree.
  # `config set` is the bot's, from a press: a report, like `status`. The
  # screen `config` alone is a conversation.
  # What the person ran, for the history of the feature it touches
  # (history_command): `sclaude <name>` alone is a resume. The run is this
  # process and everything sclaude starts below it — its re-execs after an
  # update, `_done`, `_session-ended` — which inherit it: none of those is
  # a command the person typed.
  SCLAUDE_COMMAND="${1:-menu}"
  export SCLAUDE_RUN="${SCLAUDE_RUN:-$$.${EPOCHSECONDS:-0}}"
  # Where wait_note (core/ui.sh) writes; unset, nothing is noted — a bench
  # running a function on its own writes into nobody's log.
  export SCLAUDE_WAITS_LOG="${SCLAUDE_WAITS_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/sclaude/waits.jsonl}"
  local kind="${1:-}"
  [[ "$kind" == config && "${2:-}" == set ]] && kind="config set"
  case "$kind" in
    # _handoff is the timer's: no update of the orchestrator from inside a
    # five-minute sweep, and nobody to ask anything.
    #
    # Nor a channel for questions, even one inherited: a step's claude session
    # runs under a sclaude that exported ASK_DIR, and a `sclaude status` it
    # calls would publish review_branches' question there and wait for an
    # answer nobody gives. Killed by its caller's timeout, it lived on as an
    # orphan polling the channel once a second, and held off every update of
    # instruments as "another sclaude" for as long as it lived.
    # core-open and core-ready are run by a session, under the sclaude that
    # started it: an update from here would move the checkout under both.
    # update fetches and merges by itself: the start's own sync first would
    # only say what update is about to take.
    status|ls|dev|news|checks|doctor|update|"config set"|core-open|core-ready|_flow|_handoff|-h|--help|help|-*) unset ASK_DIR ;;
    *)
      # The same line decides what is recorded (terminal.sh): a conversation
      # is worth reading back, a report is not. First, so the record holds
      # everything the run prints; it may re-execute this process.
      term_record "$@"

      # The same line between talking and reporting decides whether the
      # orchestrator updates itself first: a fetch has no business on the path
      # the bot calls with a timeout. It may re-execute this process.
      instruments_sync "$@"
      # And the units it installed, which an update changes under them.
      units_refresh

      # Through a temporary variable: an assignment inside the `if` itself would
      # leave ASK_DIR equal to "/.git/sclaude" where there is no repository at
      # all — and ask would go through a channel that does not exist.
      local _repo; _repo="$(main_repo 2>/dev/null)" || _repo=""
      if [[ -n "$_repo" && -d "$_repo/.git" ]]; then
        export ASK_DIR="$_repo/.git/sclaude"
        # The product's DORA page, when it is older than a few hours.
        dora_refresh "$_repo"
      else
        unset ASK_DIR
      fi
      ;;
  esac

  case "${1:-}" in
    # Once a month the deferred friction is offered first: see deferred.sh.
    "")            deferred_offer; cmd_menu ;;
    new)           shift; new_from_args "$@" ;;
    status|ls)     cmd_status ;;
    doctor)        doctor_run ;;
    config)        shift; cmd_config "$@" ;;
    dev)           shift; cmd_dev "$@" ;;
    # The list of actions on a feature. In the terminal people arrive here from
    # the menu, by the checkbox; from a phone there is no checkbox — there is
    # nothing to press space with there — and the card's button opens that same
    # list directly, by a command of its own.
    actions)       shift
                   if [[ -n "${1:-}" ]]; then
                     # For a named feature there is no previous menu: the list
                     # is open on its own, by a button from a phone or by a
                     # command. "Go back" is then simply an exit rather than an
                     # exit code passed outwards — a ten from the shell would
                     # read as a failure.
                     feature_actions "$(slugify "$1")" || true
                   else
                     require_repo; actions_menu "$(list_features)"
                   fi ;;
    sync)          shift; cmd_sync "$(slugify "${1:-}")" ;;
    news)          shift; cmd_news "$(slugify "${1:-}")" ;;
    preview)       shift; cmd_preview "$(slugify "${1:-}")" ;;
    # A refused rollback is an answer rather than a failure — the same reason
    # `done` ends with `|| true`.
    rollback)      shift; cmd_rollback "$(slugify "${1:-}")" || true ;;
    issue)         shift; cmd_issue "$(slugify "${1:-}")" ;;
    replan)        shift; cmd_replan "$(slugify "${1:-}")" ;;
    return)        shift; _slug="$(slugify "${1:-}")"; shift || true; cmd_return "$_slug" "$@" ;;
    # Refusing the clean-up is not a script failure: the epilogue reads
    # cmd_done's exit code, whereas to a command from the terminal it would say
    # "it did not work out", which is not what happened.
    done)          shift; cmd_done "${1:-}" || true ;;
    drop)          shift; cmd_abandon "$(slugify "${1:-}")" ;;
    friction)      shift; cmd_friction "$(slugify "${1:-}")" ;;
    deferred)      cmd_deferred ;;
    propose)       cmd_propose ;;
    workshop)      cmd_workshop ;;
    update)        cmd_update ;;
    # By the person: a workshop change they said no to goes out after all.
    core-send)     cmd_core_send ;;
    # Run by a session, to change sclaude in its tree's workshop (workshop.sh).
    core-open)     cmd_core_open ;;
    core-ready)    shift; cmd_core_ready "$@" ;;
    review-stats)  cmd_review_stats ;;
    review-report) shift; cmd_review_report "$(slugify "${1:-}")" ;;
    # The verdict is the exit code (see wait_checks): no `|| true` here.
    checks)        shift; cmd_checks "${1:-}" ;;
    # A red run is an answer, not a script failure: || true so the shell does
    # not report one where the summary has already said everything.
    regression)    shift; cmd_regression "$(slugify "${1:-}")" "${2:-}" || true ;;
    reset)         shift; cmd_reset "$(slugify "${1:-}")" ;;
    # Internal: the end of a step's session, handed over by code_reload.
    _session-ended) shift; cmd_session_ended "$@" ;;
    # Internal: where a feature stands and its actions, as JSON for its
    # process map (sclaude-proxy); a report, so no update and no channel.
    _flow)         shift; cmd_flow "$(slugify "${1:-}")" ;;
    # Internal: the timer handing over a PR that QA accepted.
    _handoff)      shift; cmd_handoff "$(slugify "${1:-}")" ;;
    # Internal: the clean-up in a fresh process (done_fresh), whose caller
    # reads its exit code — a "no" to the clean-up says "Later: …" there.
    _done)         shift; cmd_done "${1:-}" ;;
    # Without a name it prints whatever is waiting — hence slugify only when
    # there is an argument.
    epilogue)      shift; cmd_epilogue "${1:+$(slugify "$1")}" ;;
    -h|--help|help) usage ;;
    -*)            die "unknown flag: $1" ;;
    *)             cmd_resume "$(slugify "$1")" ;;
  esac
}

main "$@"
# exit INSIDE the braces: once the block finishes, bash would go on reading
# the file from the byte where the block ended, and if the file grew meanwhile
# that byte is in the middle of some line (seen as a `;;` syntax error after a
# clean-up had already succeeded).
exit
}
