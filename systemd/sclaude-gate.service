[Unit]
Description=The phone's entry to features through Telegram (sclaude-proxy --gate)
Documentation=file:@REPO@/README.md
Requires=sclaude-gate.socket
After=sclaude-gate.socket

[Service]
# Lets in only the bot's owner, by Telegram's signed initData, and passes them
# on to sclaude-proxy on :3000. Exits after half an hour with nobody looking;
# the socket brings it back on the next connection.
ExecStart=%h/.local/bin/sclaude-proxy --gate
Restart=on-failure

# No [Install] section: what is enabled is the socket.
