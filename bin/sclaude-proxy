#!/usr/bin/env python3
#
# One address for every feature's dev server: http://<feature>.localhost:3000.
#
# Each feature's `next dev` listens on a port of its own (feature_port in
# sclaude/lib/worktree.sh), and nobody is meant to remember those. This listens
# on the one port everybody already knows and hands each connection to the
# server the Host header names. Chrome resolves every *.localhost name to the
# loopback by itself, so no DNS or hosts file is involved — and a different host
# is also what keeps two features' cookies apart, which different ports alone
# would not: cookies ignore the port.
#
#   <feature>.localhost:3000    that feature's dev server
#   localhost:3000 (any host)   the feature the `sclaude_feature` cookie names,
#                               or the list of features to choose from
#   /__sclaude/                 the list, whatever the host
#   /__sclaude/login?f=<feature> that feature, signed in as the developer
#                               when the project asks for it (dev_login.py)
#
# Which feature lives where is read, never remembered. sclaude links
# ~/.claude/sclaude/dev/<feature> to the worktree, and the worktree's
# .sclaude/local/feature/state.json holds the port. Nothing here has state to clean up after
# a crash: a feature whose server is down is listed as not running, and a link
# to a tree that is gone is skipped.
#
# Routing is per connection, by its first request. A browser does not carry
# requests for two hosts over one HTTP/1.1 connection, so the first Host is the
# Host of the whole connection, and after it the bytes are only copied both
# ways. That is also why a WebSocket (Next's HMR) needs no code of its own: its
# upgrade is a request like any other, and what follows it is more bytes.
# The one place a connection could change its mind is the cookie. Every page of
# this proxy closes its connection, and so does every request routed by the
# cookie — the server is asked to close after answering (close_after) — so
# pooled connections, a browser's or `tailscale serve`'s, never carry a request
# to the feature the cookie named a moment ago.
#
# Started by systemd through sclaude-proxy.socket, which owns the port. Run by
# hand it binds the port itself:
#
#   sclaude-proxy               listen on SCLAUDE_PROXY_PORT (3000)
#   sclaude-proxy --gate        the phone's entry from the internet (see the gate)
#
# A feature nobody is running is started on the first request for it, and one
# nobody has looked at for SCLAUDE_DEV_IDLE seconds (half an hour) is stopped,
# its database with it — both through `sclaude dev`, so the proxy decides only
# when and never how. A feature is never stopped while anything is working in
# its tree: a claude session, a regression, a person's shell.
#
# The port is open on every address, because the phone comes over the tailnet,
# but only this machine and the tailnet are answered: loopback (the Windows
# browser arrives through WSL's localhost forwarding as ::1) and Tailscale's
# ranges. Anybody else who reaches :3000 — a café's Wi-Fi, a LAN in WSL's
# mirrored mode — would otherwise list every feature, browse its dev server
# and make sclaude start one. SCLAUDE_PROXY_ALLOW replaces the list with its
# own comma-separated networks.
#
# SCLAUDE_PROXY_BIND moves it off 0.0.0.0, SCLAUDE_DEV_REGISTRY off the real
# registry, SCLAUDE_BIN to a stand-in for sclaude, SCLAUDE_PROXY_TICK to a
# faster idle check and SCLAUDE_PROXY_BUILD_GRACE to a shorter wait for a first
# build — for the tests.
import asyncio
import html
import importlib
import ipaddress
import json
import os
import re
import secrets
import signal
import socket
import subprocess
import sys
import time
from urllib.parse import parse_qs, parse_qsl, urlencode, urlsplit

# realpath, not just abspath: install.sh symlinks this file into
# ~/.local/bin, and resolving through that link is how "../sclaude/lib" still
# finds the repo rather than ~/.local/sclaude/lib, which does not exist.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                "..", "sclaude", "lib"))
import feature_db  # noqa: E402 — PORT_SLOTS, the single source of truth
import dev_login  # noqa: E402
import process  # noqa: E402 — the process map, and a feature's place on it

PORT = int(os.environ.get("SCLAUDE_PROXY_PORT") or 3000)
BIND = os.environ.get("SCLAUDE_PROXY_BIND") or "0.0.0.0"
REGISTRY = os.environ.get("SCLAUDE_DEV_REGISTRY") or os.path.expanduser(
    "~/.claude/sclaude/dev")
# Loopback, and Tailscale's IPv4 and IPv6 ranges.
ALLOW = [ipaddress.ip_network(n.strip()) for n in (
    os.environ.get("SCLAUDE_PROXY_ALLOW")
    or "127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48").split(",") if n.strip()]
COOKIE = "sclaude_feature"
# A request head larger than this is not a browser's.
HEAD_LIMIT = 64 * 1024
LABEL = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$")
IDLE = int(os.environ.get("SCLAUDE_DEV_IDLE") or 1800)
TICK = float(os.environ.get("SCLAUDE_PROXY_TICK") or 60)
SCLAUDE = os.environ.get("SCLAUDE_BIN") or "sclaude"
# A start that has run this long without the server answering has failed, even
# if the process is still there. A cold feature — a new database, a first
# build — is well inside it.
START_LIMIT = 600
# `sclaude dev` returns once the server is launched, not once it answers: a
# first build keeps the port shut a while longer. This is how long a finished
# start is still "starting" rather than "failed".
BUILD_GRACE = float(os.environ.get("SCLAUDE_PROXY_BUILD_GRACE") or 180)
# How long the regression's mark that its build holds the port is believed:
# two hours, well past a whole suite, so a run that died leaves the feature
# without a lazy start for no longer than that.
SERVING_LIMIT = 7200

# Per feature label: the `sclaude dev` that is starting it and when, the one
# stopping it, and when a connection for it was last opened. In memory only: a
# restarted proxy forgets them, which costs one idle period of patience.
STARTING = {}
STOPPING = {}
LAST_SEEN = {}


def feature_dir(wt):
    """A tree's feature folder. A tree an older sclaude still runs keeps its
    state in .feature/ until that sclaude is done (layout_migrate waits for
    it); decided by the state file, as telegramd.state_path does."""
    new = os.path.join(wt, ".sclaude/local/feature")
    old = os.path.join(wt, ".feature")
    if not os.path.isfile(os.path.join(new, "state.json")) \
            and os.path.isfile(os.path.join(old, "state.json")):
        return old
    return new


def feature(label):
    """(worktree, dev port, db.base) for a feature, or None when it is not
    registered.

    A link to a tree that is gone is no feature: sclaude clears such links on
    its next claim, and until then they are skipped. The dev port is None when
    the tree has none recorded or its state cannot be read; db.base is None
    the same way, and for main, which has none — its stack is the shared one,
    on the ports its own config names rather than a block of its own."""
    if not LABEL.match(label):
        return None
    link = os.path.join(REGISTRY, label)
    if not os.path.islink(link):
        return None
    wt = os.path.realpath(link)
    state = os.path.join(feature_dir(wt), "state.json")
    if not os.path.isfile(state):
        return None
    # A tree being removed: sclaude has stopped its server on purpose, and a
    # lazy start here would bring it back into a directory git is deleting.
    if os.path.exists(os.path.join(os.path.dirname(state), "closing")):
        return None
    try:
        with open(state) as fh:
            data = json.load(fh)
        port = (data.get("dev") or {}).get("port")
        base = (data.get("db") or {}).get("base")
    except (OSError, ValueError, AttributeError):
        port = base = None
    return (wt, port if isinstance(port, int) else None,
            base if isinstance(base, int) else None)


def features():
    try:
        names = sorted(os.listdir(REGISTRY))
    except OSError:
        return []
    out = []
    for name in names:
        found = feature(name)
        if found:
            out.append((name,) + found)
    return out


# --- a feature's own Supabase -------------------------------------------------
#
# Alongside the dev server, a feature working against the project's local
# stack (featuredb.sh) has web UIs of its own: Supabase Studio and the
# Inbucket mail catcher, each on a port ten apart from the others in the
# feature's block (feature_db.PORT_SLOTS — the same map that lays the block
# out in the first place, so a slot moved there never goes stale here). main
# has no block — it runs the one local stack everybody shares, on the ports
# supabase/config.toml itself names. Both are read, never remembered, same as
# a feature's dev port: a stack that was never started, or whose config does
# not enable a UI, has no port to show and is left out.
#
# Kept to the two that are worth opening in a browser. The API port (Kong) is
# an endpoint for curl/fetch, not a page, and Analytics needs Logflare
# credentials nobody has here — both would just be dead links.
SERVICE_NAMES = {"studio": "Supabase Studio", "local_smtp": "Inbucket", "inbucket": "Inbucket"}
SECTION_RE = re.compile(r"^\s*\[([^\]]+)\]\s*(#.*)?$")
ENABLED_RE = re.compile(r"^\s*enabled\s*=\s*(true|false)\s*(#.*)?$")
PORT_RE = re.compile(r"^\s*port\s*=\s*(\d+)\s*(#.*)?$")
NOT_SET = object()


def config_ports(config_path):
    """{section: port} of every enabled section in a supabase/config.toml that
    SERVICE_NAMES cares about, read directly rather than through the CLI —
    this runs once per page load and must not shell out.

    A section with no `port` line at all is as absent as one that is
    disabled; `port = 0` is not — NOT_SET tells the two apart, where a bare
    truthiness check on the port would wrongly drop the second."""
    try:
        with open(config_path) as fh:
            text = fh.read()
    except OSError:
        return {}
    section, enabled, port, out = None, True, NOT_SET, {}

    def flush():
        if section in SERVICE_NAMES and enabled and port is not NOT_SET:
            out[section] = port

    for line in text.splitlines():
        m = SECTION_RE.match(line)
        if m:
            flush()
            section, enabled, port = m.group(1), True, NOT_SET
            continue
        m = ENABLED_RE.match(line)
        if m and section is not None:
            enabled = m.group(1) == "true"
            continue
        m = PORT_RE.match(line)
        if m and section is not None:
            port = int(m.group(1))
    flush()
    return out


def services(label, wt, base):
    """[(name, port)] of a feature's — or main's — own Studio and Inbucket.

    `base` is None for main and for a feature with no database block of its
    own (sharing the main local database); either way there is nothing to
    offer. Otherwise the ports are `base + slot` for a feature, or the
    literal ports its own config.toml names for main, which has no block."""
    ports = config_ports(os.path.join(wt, "supabase", "config.toml"))
    seen, out = set(), []
    for section, name in SERVICE_NAMES.items():
        slot = feature_db.PORT_SLOTS.get((section, "port"))
        if section not in ports or slot is None or slot in seen:
            continue
        seen.add(slot)
        if label == "main":
            out.append((name, ports[section]))
        elif base is not None:
            out.append((name, base + slot))
    return out


def answers(port):
    if not port:
        return False
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.3):
            return True
    except OSError:
        return False


def parse_head(head):
    """(method, target, {lowercased header: value}) of a request head."""
    lines = head.decode("latin-1").split("\r\n")
    parts = lines[0].split(" ")
    headers = {}
    for line in lines[1:]:
        name, sep, value = line.partition(":")
        if sep:
            headers[name.strip().lower()] = value.strip()
    return (parts[0] if parts else ""), (parts[1] if len(parts) > 1 else "/"), headers


def host_label(host):
    """The feature a Host header names, or "" for a host that names none."""
    name = host.rsplit(":", 1)[0] if not host.startswith("[") else ""
    name = name.lower().rstrip(".")
    if name.endswith(".localhost"):
        return name[: -len(".localhost")].rsplit(".", 1)[-1]
    return ""


def cookie_label(header):
    for part in header.split(";"):
        name, _, value = part.strip().partition("=")
        if name == COOKIE:
            return value.strip()
    return ""


def is_local(host):
    name = host.rsplit(":", 1)[0].lower()
    return name in ("localhost", "127.0.0.1", "[::1]") or name.endswith(".localhost")


# --- the proxy's own pages ---------------------------------------------------

STYLE = """
body{font:15px/1.5 system-ui,sans-serif;margin:0;padding:24px 16px;
background:#fafaf9;color:#1c1917}
main{max-width:720px;margin:0 auto}
h1{font-size:20px;margin:0 0 4px}
p{color:#57534e;margin:0 0 16px}
table{width:100%;border-collapse:collapse}
td{padding:8px 6px;border-top:1px solid #e7e5e4;vertical-align:top}
td.path{color:#78716c;font-size:13px;word-break:break-all}
td.sub{padding-left:22px;font-size:13px}
.up{color:#15803d}.down{color:#a8a29e}
a{color:#1d4ed8}
a.alt{font-size:12px;color:#78716c;margin-left:6px}
code{font-size:13px}
pre{font-size:12px;background:#f5f5f4;padding:8px 10px;border-radius:6px;
white-space:pre-wrap;word-break:break-all}
@media (prefers-color-scheme:dark){body{background:#1c1917;color:#f5f5f4}
p,td.path{color:#a8a29e}td{border-color:#44403c}a{color:#93c5fd}.up{color:#4ade80}
pre{background:#292524}}
"""


def page(title, body):
    return ("<!doctype html><html><head><meta charset=utf-8>"
            "<meta name=viewport content='width=device-width,initial-scale=1'>"
            "<title>%s</title><style>%s</style></head><body><main>%s</main>"
            "</body></html>" % (html.escape(title), STYLE, body))


def probe_features():
    """[(label, wt, live dev server?, [(name, port), …live services],
    sign-in offered?)] — every blocking connect() and git call a listing
    needs, gathered in one pass off the event loop (see gather_listing). A
    feature's own services are probed only once each, same cost `answers`
    already pays for the dev server itself."""
    out = []
    for label, wt, fport, base in features():
        live = [(name, sport) for name, sport in services(label, wt, base)
                if answers(sport)]
        out.append((label, wt, answers(fport), live, dev_login.offered(wt)))
    return out


def listing(host, probed, note="", code_up=None):
    """The rendered page from `probed` (probe_features()'s result) — pure
    string building, no I/O, so it is safe to call straight from the event
    loop once the blocking work is done."""
    local = is_local(host)
    port = host.rsplit(":", 1)[1] if ":" in host and not host.endswith("]") else ""
    rows = []
    for label, wt, live, live_services, login in probed:
        if local:
            plain = "http://%s.localhost%s/" % (label, ":" + port if port else "")
        else:
            plain = "/__sclaude/select?f=%s" % label
        # Signed in by default where the project asks for it; signing out
        # afterwards is the product's own button, and the plain address is
        # one link away.
        href = "/__sclaude/login?f=%s" % label if login else plain
        other = (" <a class=alt href='%s'>without signing in</a>" % html.escape(plain)
                 if login else "")
        rows.append(
            "<tr><td><a href='%s'>%s</a>%s</td>"
            "<td class='%s'>%s</td><td class=path>%s</td></tr>" % (
                html.escape(href), html.escape(label), other,
                "up" if live else "down",
                "running" if live else "not running",
                html.escape(wt)))
        for name, sport in live_services:
            rows.append(
                "<tr><td class=sub><a href='http://127.0.0.1:%d/'>%s — %s</a></td>"
                "<td class=up>running</td><td class=path></td></tr>" % (
                    sport, html.escape(label), html.escape(name)))
        # code-server on this tree, from this machine (code_up is None from
        # anywhere else: the phone has the gate's own, under /__code/).
        if code_up is not None:
            rows.append(
                "<tr><td class=sub><a href='/__sclaude/code?f=%s'>%s — Code Server</a></td>"
                "<td class='%s'>%s</td><td class=path></td></tr>" % (
                    html.escape(label), html.escape(label),
                    "up" if code_up else "down", "running" if code_up else "starts on opening"))
        # The process map: main's is the whole cycle, a feature's has where
        # it stands lit and the actions open to it now.
        rows.append(
            "<tr><td class=sub><a href='%s'>%s — %s</a></td><td></td><td class=path></td></tr>" % (
                "/__sclaude/bpmn" if label == "main"
                else "/__sclaude/flow?f=%s" % html.escape(label),
                html.escape(label), MAP_NAME))
        if label == "main":
            rows.append(
                "<tr><td class=sub><a href='/__sclaude/dora'>main — %s</a></td><td></td>"
                "<td class=path></td></tr>" % DORA_NAME)
    table = ("<table>%s</table>" % "".join(rows)) if rows else \
        "<p>No feature has a dev server registered yet.</p>"
    hint = ("<p>Opening a feature that is not running starts it. One nobody has "
            "opened for a while is stopped again, its database with it.</p>")
    lead = "<p>%s</p>" % html.escape(note) if note else ""
    return page("Features", "<h1>Features</h1>%s%s%s" % (lead, table, hint))


async def gather_listing(host, note=""):
    """listing(), with every socket probe run in a worker thread — the same
    move idle_features makes and for the same reason: on the event loop this
    is one page load blocking every proxied connection, HMR sockets included,
    for as long as the slowest of N features' dev port and two services take
    to time out."""
    code_up = (await asyncio.to_thread(code_running)) if is_local(host) else None
    # From elsewhere, or with no code-server service: no line at all.
    return listing(host, await asyncio.to_thread(probe_features), note, code_up)


# --- starting and stopping ---------------------------------------------------

def run_env():
    """The environment for `sclaude dev`: the PATH of the shell that last ran it.

    Under systemd this process has none of that shell's PATH — no nvm, so no
    node, npm or npx, and possibly no sclaude. sclaude leaves its own PATH in
    the registry each time it starts a server (ensure_dev)."""
    env = dict(os.environ)
    for name in ("LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES"):
        env.pop(name, None)
    try:
        with open(os.path.join(REGISTRY, ".path")) as fh:
            path = fh.read().strip()
        if path:
            env["PATH"] = heal_path(path)
    except OSError:
        pass
    return env


def heal_path(path):
    """The saved PATH with each Node that is gone swapped for the one that is there.

    The PATH is saved by whoever last ran `sclaude dev` from a shell, and names
    one Node by version: ~/.nvm/versions/node/v24.21.0/bin. wsl-update installs
    the next release and uninstalls the old one, so the saved directory stops
    existing the morning after — and with it npm. On 2026-10-20 every lazy start
    died at `setsid: failed to execute npm` until somebody ran sclaude by hand.

    So an entry under an nvm `versions/node/` directory that no longer exists is
    replaced by the newest version installed beside it. Nothing else is touched:
    a missing directory elsewhere on the PATH is not the proxy's to guess at."""
    def version_key(name):
        try:
            return tuple(int(part) for part in name.lstrip("v").split("."))
        except ValueError:
            return ()

    healed = []
    for entry in path.split(os.pathsep):
        versions = os.path.dirname(os.path.dirname(entry))
        if (os.path.basename(entry) == "bin" and not os.path.isdir(entry)
                and versions.endswith(os.path.join("versions", "node"))):
            try:
                installed = [name for name in os.listdir(versions)
                             if os.path.isdir(os.path.join(versions, name, "bin"))]
            except OSError:
                installed = []
            if installed:
                entry = os.path.join(versions, max(installed, key=version_key), "bin")
        healed.append(entry)
    return os.pathsep.join(healed)


class NotStarted:
    """A start that could not even be launched — no sclaude on the PATH, a log
    that cannot be opened. Behaves as a process that has already failed, so
    the page says so once instead of the connection dying on every reload."""

    pid = -1

    def __init__(self, reason):
        self.reason = reason

    def poll(self):
        return 127


def spawn(wt, args):
    log = os.path.join(feature_dir(wt), "lazy-start.log")
    try:
        with open(log, "ab") as out:
            out.write(("\n$ sclaude dev %s  (%s)\n" % (" ".join(args), time.strftime("%F %T"))).encode())
            out.flush()
            return subprocess.Popen([SCLAUDE, "dev"] + args, cwd=wt, env=run_env(),
                                    stdin=subprocess.DEVNULL, stdout=out,
                                    stderr=subprocess.STDOUT, start_new_session=True)
    except OSError as exc:
        return NotStarted("could not run `%s dev %s`: %s" % (SCLAUDE, " ".join(args), exc))


def start_state(label, wt):
    """'starting' or 'failed' for a feature whose server does not answer.

    Starts it the first time it is asked, and once only: every request after
    that finds the start already running. A start that failed stays failed
    until somebody asks again through /__sclaude/start — retrying on every
    request would restart a broken build in a loop.

    One case looks like a failure and is not: a start that succeeded long ago
    whose server has since been stopped — from the bot, or by hand — without
    a request through here in between to clear it. That is started again, once;
    a server that goes quiet twice in a row after a clean start is a failure."""
    now = time.time()
    # The regression is swapping the dev server for its own build (sclaude's
    # regression_serve_build): the port is closed for a moment on purpose, and
    # a start here would take it from the build. A mark older than any suite
    # is a run that died halfway, and the start goes ahead.
    try:
        mark = os.path.join(feature_dir(wt), "serving-build")
        if now - os.path.getmtime(mark) < SERVING_LIMIT:
            return "starting"
    except OSError:
        pass
    tries = 0
    entry = STARTING.get(label)
    if entry:
        proc, since, tries = entry
        code = proc.poll()
        if code is None and now - since < START_LIMIT:
            return "starting"
        if code == 0 and now - since < BUILD_GRACE:
            return "starting"
        if code != 0 or tries >= 2:
            return "failed"
    STOPPING.pop(label, None)
    STARTING[label] = (spawn(wt, ["--no-browser"]), now, tries + 1)
    return "starting"


def log_tail(wt, lines=15):
    try:
        with open(os.path.join(feature_dir(wt), "lazy-start.log"), "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - 8192))
            text = fh.read().decode("utf-8", "replace")
    except OSError:
        return ""
    return "\n".join(text.rstrip().split("\n")[-lines:])


# X-Sclaude-Proxy says a 503 or 502 is this page and not the application's
# own, passed through: a project's test setup can wait on "starting" and stop
# on "failed", and on nothing else.
def status_page(label, wt, state):
    tail = log_tail(wt)
    entry = STARTING.get(label)
    if entry and isinstance(entry[0], NotStarted):
        tail = entry[0].reason
    tail = html.escape(tail)
    if state == "starting":
        body = ("<h1>Starting %s…</h1><p>Its dev server was not running, so it is "
                "being started now. A feature's first start also builds its "
                "database and its pages: about a minute. This page reloads by "
                "itself.</p>" % html.escape(label))
        extra = ("Retry-After: 2", "X-Sclaude-Proxy: starting")
        title, status = "Starting", "503 Service Unavailable"
        refresh = "<meta http-equiv=refresh content=2>"
    else:
        body = ("<h1>%s did not start</h1><p><a href='/__sclaude/start?f=%s'>Try "
                "again</a>, or run <code>sclaude dev %s</code> in a terminal to "
                "see why.</p>" % (html.escape(label), html.escape(label), html.escape(label)))
        extra = ("X-Sclaude-Proxy: failed",)
        title, status, refresh = "Not started", "502 Bad Gateway", ""
    if tail:
        body += "<pre>%s</pre>" % tail
    text = page(title, body).replace("<head>", "<head>" + refresh, 1)
    return respond(status, text, extra)


# --- stopping the idle --------------------------------------------------------
#
# The check runs in a worker thread: it reads all of /proc and runs `ss`, and
# on the event loop that would stall every proxied connection — HMR sockets and
# page loads of every feature — for the length of it. The thread gets a
# snapshot of what the loop knows and returns the features to stop; the loop
# alone touches STARTING and STOPPING and starts processes.

def listeners():
    """{port: set of process groups listening on it}, from one `ss` run."""
    try:
        out = subprocess.run(["ss", "-ltnpH"], capture_output=True, text=True,
                             timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    groups = {}
    for line in out.splitlines():
        cols = line.split()
        if len(cols) < 4:
            continue
        port = cols[3].rsplit(":", 1)[-1]
        if not port.isdigit():
            continue
        for pid in re.findall(r"pid=(\d+)", line):
            try:
                groups.setdefault(int(port), set()).add(os.getpgid(int(pid)))
            except OSError:
                pass
    return groups


def working_dirs():
    """[(pid, pgid, cwd)] of every process whose directory can be read, from
    one pass over /proc."""
    out = []
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            out.append((pid, os.getpgid(pid), os.readlink("/proc/%d/cwd" % pid)))
        except OSError:
            continue
    return out


def busy(root, server_groups, processes, mine):
    """Is anything but the server itself working in this tree?

    A claude session, a regression, a person's shell: each has its working
    directory in the tree. The server has too, so its own process group is left
    out — along with anything the proxy itself started there."""
    for pid, pgid, cwd in processes:
        if cwd != root and not cwd.startswith(root + "/"):
            continue
        if pgid in server_groups or pid in mine:
            continue
        return True
    return False


def idle_features(snapshot):
    """The features to stop: (label, wt). Runs off the event loop.

    `snapshot` is what the loop knew when the tick began: last connections,
    start times, which starts and stops are still running, the pids it
    started."""
    now = time.time()
    candidates = []
    for label, wt, port, _base in features():
        if label in snapshot["running"] or not answers(port):
            continue
        seen = [snapshot["seen"].get(label, 0.0), snapshot["started"].get(label, 0.0)]
        try:
            seen.append(os.path.getmtime(os.path.join(feature_dir(wt), "dev.log")))
        except OSError:
            pass
        if now - max(seen) >= IDLE:
            candidates.append((label, wt, port))
    if not candidates:
        return []
    groups = listeners()
    processes = working_dirs()
    return [(label, wt) for label, wt, port in candidates
            if not busy(os.path.realpath(wt), groups.get(port, set()), processes,
                        snapshot["mine"])]


async def reaper():
    while True:
        await asyncio.sleep(TICK)
        try:
            snapshot = {
                "seen": dict(LAST_SEEN),
                "started": {k: v[1] for k, v in STARTING.items()},
                "running": {k for k, v in STARTING.items() if v[0].poll() is None}
                           | {k for k, p in STOPPING.items() if p.poll() is None},
                "mine": {v[0].pid for v in STARTING.values()} | {p.pid for p in STOPPING.values()},
            }
            for label, wt in await asyncio.to_thread(idle_features, snapshot):
                # Asked for again while the check ran: not idle after all.
                if LAST_SEEN.get(label, 0.0) > max(snapshot["seen"].get(label, 0.0), 0.0):
                    continue
                STARTING.pop(label, None)
                STOPPING[label] = spawn(wt, ["--stop"])
        except Exception as exc:  # the proxy must outlive a bad tick
            sys.stderr.write("sclaude-proxy: idle check failed: %s\n" % exc)


def respond(status, body, extra=(), kind="text/html; charset=utf-8"):
    data = body.encode("utf-8")
    head = ["HTTP/1.1 %s" % status,
            "Content-Type: %s" % kind,
            "Content-Length: %d" % len(data),
            "Cache-Control: no-store",
            # Every page of ours closes its connection: see the note at the top
            # on why the next request must be routed afresh.
            "Connection: close"]
    # A header carrying CR or LF would end itself and start others: dropped,
    # whatever let it get this far.
    head.extend(h for h in extra if "\r" not in h and "\n" not in h)
    return ("\r\n".join(head) + "\r\n\r\n").encode("latin-1") + data


# The cookie @supabase/ssr keeps a session in: sb-<ref>-auth-token, split
# into .0, .1, … when it is long. Only its name is looked at.
SESSION_COOKIE = re.compile(r"^sb-.+-auth-token(\.\d+)?$")


def signed_in(header):
    return any(SESSION_COOKIE.match(part.strip().partition("=")[0])
               for part in header.split(";"))


async def login_page(url, host, headers):
    """/__sclaude/login: open a feature, signed in as the developer.

    Done on the feature's own host, where its cookies are: a browser that
    already holds a session there keeps it — the developer's, or another user
    somebody signed in as on purpose — and is only sent on. Off this machine
    every feature shares one host (the cookie routes it), so a session cookie
    there may be another feature's and says nothing: the phone always signs
    in afresh. A project with no devLogin gets the feature as it is."""
    query = parse_qs(url.query)
    label = (query.get("f") or [""])[0] or host_label(host)
    nxt = dev_login.safe_next((query.get("next") or ["/"])[0])
    found = feature(label)
    if not found:
        return respond("404 Not Found",
                       await gather_listing(host, "No such feature: %s" % label))
    wt, fport, _base = found
    local = is_local(host)
    port = host.rsplit(":", 1)[1] if ":" in host and not host.endswith("]") else ""
    origin = "http://%s.localhost%s" % (label, ":" + port if port else "")
    if local and host_label(host) != label:
        # To the feature's host first, which is where its cookies are read.
        return respond("303 See Other", "", (
            "Location: %s/__sclaude/login?%s" % (origin, urlencode({"next": nxt})),))
    routed = () if local else (
        "Set-Cookie: %s=%s; Path=/; SameSite=Lax" % (COOKIE, label),)
    offered = await asyncio.to_thread(dev_login.offered, wt)
    if not offered or (local and signed_in(headers.get("cookie", ""))):
        return respond("303 See Other", "", ("Location: %s" % nxt,) + routed)
    # Its database comes up with its server: until it answers there is no
    # Supabase to ask, and the page reloads this same address.
    if not await asyncio.to_thread(answers, fport):
        return status_page(label, wt, start_state(label, wt))
    try:
        where = await asyncio.to_thread(dev_login.link, wt, nxt)
    except dev_login.Refused as exc:
        return respond("409 Conflict", page("Not signed in", (
            "<h1>%s: not signed in</h1><p>%s.</p><p><a href='%s'>Open it without "
            "signing in</a></p>") % (html.escape(label), html.escape(str(exc)),
                                    html.escape(nxt if not local else origin + nxt))),
            routed)
    return respond("303 See Other", "", ("Location: %s" % where,) + routed)


async def own_page(target, host, headers=None):
    """The response to a /__sclaude/ request."""
    url = urlsplit(target)
    if url.path == "/__sclaude/login":
        return await login_page(url, host, headers or {})
    if url.path == "/__sclaude/select":
        label = (parse_qs(url.query).get("f") or [""])[0]
        if not feature(label):
            return respond("404 Not Found",
                           await gather_listing(host, "No such feature: %s" % label))
        return respond("303 See Other", "", (
            "Location: /",
            "Set-Cookie: %s=%s; Path=/; SameSite=Lax" % (COOKIE, label)))
    if url.path == "/__sclaude/ping":
        # What sclaude asks many times a step: is the proxy here? The list
        # would answer too, but it probes every feature's port to draw itself.
        return respond("200 OK", "sclaude-proxy")
    if url.path == "/__sclaude/start":
        # A failed start is not retried on its own; this is the retry.
        label = (parse_qs(url.query).get("f") or [""])[0]
        found = feature(label)
        if not found:
            return respond("404 Not Found",
                           await gather_listing(host, "No such feature: %s" % label))
        STARTING.pop(label, None)
        start_state(label, found[0])
        local = is_local(host)
        port = host.rsplit(":", 1)[1] if ":" in host and not host.endswith("]") else ""
        target = ("http://%s.localhost%s/" % (label, ":" + port if port else "")) if local else "/"
        return respond("303 See Other", "", ("Location: %s" % target,))
    if url.path == "/__sclaude/flow":
        label = (parse_qs(url.query).get("f") or [""])[0]
        found = feature(label)
        if not found:
            return respond("404 Not Found",
                           await gather_listing(host, "No such feature: %s" % label))
        # From the Mini App (start=1): the map is opened to look at the
        # feature, so its dev server comes up with it, as opening it would.
        if (parse_qs(url.query).get("start") or [""])[0] == "1" and found[1] \
                and not await asyncio.to_thread(answers, found[1]):
            start_state(label, found[0])
        return respond("200 OK", process_map().page(label))
    if url.path == "/__sclaude/code":
        # code-server on the tree, its service started first when it is down.
        # From this machine only: the phone has the gate's own.
        # Starting a service is not for another site's page to do: a link
        # followed passes, an image or a fetch from elsewhere does not.
        if cross_site("GET", headers or {}):
            return respond("403 Forbidden", page("Refused", "<p>Open it from the list.</p>"))
        label = (parse_qs(url.query).get("f") or [""])[0]
        found = feature(label)
        if not found or not is_local(host):
            return respond("404 Not Found",
                           await gather_listing(host, "No such feature: %s" % label))
        # Started only when nothing answers yet: the socket, or a code-server
        # run some other way, is already the way in.
        if not await asyncio.to_thread(code_running) and not await asyncio.to_thread(answers, 8080):
            try:
                done = await asyncio.to_thread(
                    subprocess.run, ["systemctl", "--user", "start", CODE_SERVICE],
                    stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
                why = done.stderr.strip() if done.returncode else ""
            except (OSError, subprocess.TimeoutExpired) as exc:
                why = str(exc) or "systemctl did not answer"
            if why:
                return respond("502 Bad Gateway", page("Not started", (
                    "<h1>code-server did not start</h1><p>%s</p>" % html.escape(why))))
        # Whatever the service says: active comes the moment it forks, the
        # port only once it has bound — and with the socket, at once.
        for _ in range(20):
            if await asyncio.to_thread(answers, 8080):
                break
            await asyncio.sleep(0.5)
        return respond("303 See Other", "", (
            "Location: %s/?%s" % (CODE_LOCAL, urlencode({"folder": found[0]})),))
    if url.path == "/__sclaude/bpmn":
        # The whole cycle with no feature's place on it: the printed page,
        # drawn from the model now rather than read from a build.
        return respond("200 OK", process_map().doc())
    if url.path == "/__sclaude/dora":
        return respond("200 OK", await asyncio.to_thread(dora_page))
    if url.path == "/__sclaude/flow/state":
        label = (parse_qs(url.query).get("f") or [""])[0]
        found = feature(label)
        if not found:
            return respond("404 Not Found", json.dumps({"error": "no such feature"}),
                           kind="application/json; charset=utf-8")
        body = await flow_state(label, found[0])
        return respond("200 OK", body, kind="application/json; charset=utf-8")
    if url.path == "/__sclaude/clear":
        return respond("303 See Other", "", (
            "Location: /__sclaude/",
            "Set-Cookie: %s=; Path=/; Max-Age=0; SameSite=Lax" % COOKIE))
    return respond("200 OK", await gather_listing(host))


def dora_page():
    """The DORA page main's checkout holds, or a page saying when it will."""
    found = feature("main")
    try:
        with open(os.path.join(found[0], DORA_PAGE), encoding="utf-8") as fh:
            return fh.read()
    except (OSError, TypeError):
        return page(DORA_NAME, (
            "<h1>%s</h1><p>Not built yet. sclaude builds it in the background "
            "each time it starts in this product, and again when a feature is "
            "finished; it takes a minute.</p>" % DORA_NAME))


# --- a feature's process map -------------------------------------------------
#
# /__sclaude/flow?f=<label> is the process map (sclaude/lib/process.py) with
# where the feature stands lit and the actions open to it now; the page asks
# /__sclaude/flow/state every few seconds, which runs `sclaude _flow` in the
# feature's tree. One run at a time per feature, and an answer kept a few
# seconds: two tabs open on one feature do not double the gh calls.
FLOW_PREFIX = "/__sclaude/flow?f="
MAP_NAME = "Process map (BPMN)"
# The product's DORA metrics, under main: a page sclaude rebuilds in the
# background (sclaude/lib/dora.py) inside the main checkout, served from there
# as it stands. Only main's — the numbers are the product's, not a feature's.
DORA_PAGE = ".sclaude/local/dora/index.html"
DORA_NAME = "DORA metrics"
# code-server for this machine's browser, at one address either way install.sh
# sets it up: code-server-local.socket listening here and starting code-server
# on contact (bind-addr elsewhere), or code-server itself on 127.0.0.1:8080
# with the socket left off — and then nothing starts it on contact, so
# /__sclaude/code starts the service first. Whether it runs is the
# service's to say: the socket's port always answers.
CODE_LOCAL = "http://127.0.0.1:8080"
CODE_SERVICE = os.environ.get("SCLAUDE_CODE_SERVICE") or "code-server.service"


def code_running():
    """True while code-server's service runs, False while it does not, None
    where there is no such service — no line for it then."""
    try:
        done = subprocess.run(["systemctl", "--user", "show", "-p", "LoadState,ActiveState", "--value",
                               CODE_SERVICE], stdin=subprocess.DEVNULL, capture_output=True,
                              text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    load, _, active = done.stdout.strip().partition("\n")
    if done.returncode != 0 or load.strip() != "loaded":
        return None
    return active.strip() == "active"
FLOW_FRESH = float(os.environ.get("SCLAUDE_FLOW_FRESH") or 14)
FLOW_LIMIT = 60
FLOW = {}


_PROCESS_SEEN = [None]


def process_map():
    """sclaude/lib/process.py as it is on disk now. The proxy runs for days,
    and sclaude's update pulls a new model under it: read again whenever the
    file changed, so the map served is the one the checkout has."""
    global process
    try:
        stamp = os.stat(process.__file__).st_mtime_ns
    except OSError:
        return process
    if _PROCESS_SEEN[0] is not None and stamp != _PROCESS_SEEN[0]:
        try:
            process = importlib.reload(process)
        except Exception as exc:  # a broken edit: keep serving the last good one
            sys.stderr.write("process map not reloaded: %s\n" % exc)
            return process
    _PROCESS_SEEN[0] = stamp
    return process


def flow_slug(wt):
    """The feature's own name, which `sclaude _flow` takes: the label is
    the dev server's host name, which need not be the same."""
    try:
        with open(os.path.join(feature_dir(wt), "state.json")) as fh:
            return json.load(fh).get("feature") or ""
    except (OSError, ValueError, AttributeError):
        return ""


def flow_run(wt):
    """`sclaude _flow` in the feature's tree, its JSON line or an error.

    In a session of its own, ended whole on a timeout: killing sclaude alone
    would leave a hung `git fetch` or `gh` holding its stdout, and the read
    would wait on them for ever."""
    slug = flow_slug(wt) or os.path.basename(wt)
    answer = {}
    try:
        proc = subprocess.Popen([SCLAUDE, "_flow", slug], cwd=wt, env=run_env(),
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        proc = None
    if proc:
        try:
            out, _ = proc.communicate(timeout=FLOW_LIMIT)
            lines = out.decode("utf-8", "replace").strip().splitlines()
            answer = json.loads(lines[-1]) if lines else {}
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except OSError:
                pass
            proc.communicate()
        except (ValueError, IndexError):
            answer = {}
    if not answer:
        answer = {"error": "sclaude _flow did not answer"}
    return json.dumps(answer)


def flow_state(label, wt):
    """The feature's answer, at most FLOW_FRESH old, from one run at a time.

    The run is kept apart from the requests that wait on it: a request that
    goes away (a tab closed) leaves it running, and its result is stored
    when it ends, whoever is still waiting."""
    held = FLOW.setdefault(label, {"at": 0.0, "body": "{}", "task": None})
    if time.time() - held["at"] < FLOW_FRESH:
        return asyncio.sleep(0, held["body"])
    if held["task"] is None:
        task = asyncio.ensure_future(asyncio.to_thread(flow_run, wt))

        def stored(done):
            held["task"] = None
            if not done.cancelled() and done.exception() is None:
                held["at"], held["body"] = time.time(), done.result()
        task.add_done_callback(stored)
        held["task"] = task
    return asyncio.shield(held["task"])


# --- the connection ----------------------------------------------------------

async def pipe(reader, writer):
    try:
        while True:
            chunk = await reader.read(65536)
            if not chunk:
                break
            writer.write(chunk)
            await writer.drain()
    except (ConnectionError, OSError):
        pass
    finally:
        try:
            if writer.can_write_eof():
                writer.write_eof()
        except (OSError, RuntimeError):
            pass


def close_after(head):
    """A request head with its connection set to close after the response."""
    lines = head.decode("latin-1").split("\r\n")
    kept = [line for line in lines[1:] if line and not line.lower().startswith(
        ("connection:", "keep-alive:", "proxy-connection:"))]
    return ("\r\n".join([lines[0]] + kept + ["Connection: close", "", ""])).encode("latin-1")


def allowed(peer):
    """Whether a connection from this address is answered at all."""
    try:
        ip = ipaddress.ip_address(peer.split("%", 1)[0])
    except ValueError:
        return False
    # A dual-stack socket reports an IPv4 peer as ::ffff:a.b.c.d.
    if ip.version == 6 and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    return any(ip in net for net in ALLOW if net.version == ip.version)


async def handle(reader, writer):
    upstream = None
    try:
        try:
            head = await asyncio.wait_for(reader.readuntil(b"\r\n\r\n"), 30)
        except (asyncio.IncompleteReadError, asyncio.LimitOverrunError,
                asyncio.TimeoutError, ConnectionError):
            return
        # After the head, not before: closing on a request still unread makes
        # the kernel answer with a reset instead of the 403.
        peer = writer.get_extra_info("peername")
        if not (peer and allowed(peer[0])):
            writer.write(b"HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n"
                         b"Connection: close\r\n\r\n")
            await writer.drain()
            return
        method, target, headers = parse_head(head)
        host = headers.get("host", "")

        if target.startswith("/__sclaude/") or target == "/__sclaude":
            writer.write(await own_page(target, host, headers))
            await writer.drain()
            return

        label = host_label(host)
        by_cookie = False
        if not label:
            label = cookie_label(headers.get("cookie", ""))
            by_cookie = bool(label)
        if not label:
            writer.write(respond("200 OK", await gather_listing(host)))
            await writer.drain()
            return

        found = feature(label)
        if not found:
            writer.write(respond("404 Not Found",
                                 await gather_listing(host, "No such feature: %s" % label)))
            await writer.drain()
            return
        wt, port, _base = found
        try:
            if not port:
                raise OSError("no port recorded")
            up_reader, upstream = await asyncio.wait_for(
                asyncio.open_connection("127.0.0.1", port), 5)
        except (OSError, asyncio.TimeoutError):
            writer.write(status_page(label, wt, start_state(label, wt)))
            await writer.drain()
            return

        LAST_SEEN[label] = time.time()
        STARTING.pop(label, None)
        # A connection routed by the cookie carries one request. The routing is
        # decided once per connection, and a bare host is where the cookie
        # changes: a browser's pooled connections, and those `tailscale serve`
        # keeps to this port for every phone, would otherwise carry the next
        # request — after a switch to another feature — to this one. So the
        # server is asked to close after answering, and the next request comes
        # on a fresh connection and is routed afresh. A WebSocket upgrade is
        # left alone: it is one long exchange by design.
        if by_cookie and headers.get("upgrade", "").lower() != "websocket":
            head = close_after(head)
        upstream.write(head)
        await asyncio.gather(pipe(reader, upstream), pipe(up_reader, writer))
    finally:
        for w in (upstream, writer):
            if w is not None:
                try:
                    w.close()
                except (OSError, RuntimeError):
                    pass


# --- the gate: the phone's entry from the internet ---------------------------
#
# `sclaude-proxy --gate` is what `tailscale funnel` publishes for the phone's
# Telegram Mini App (sclaude-gate.socket on 127.0.0.1:3001 and :3002; the
# funnel stays on, because Tailscale takes a minute and a half to carry a
# freshly enabled one). It routes nothing itself: a request it lets in goes on
# to the proxy on :3000, or to code-server, as it came, so starting, routing
# and idling stay in one process. Its own job is who: a page opened from the
# bot proves itself with Telegram's signed initData once (tg_webapp.py) and
# then carries the gate's cookie; anything without it gets a 403.
#
# One request per connection, always: funnel keeps its connections to this
# port and would carry the next request — anybody's — down one that was
# checked a moment ago. A WebSocket upgrade is one exchange and stays whole.
#
# It ends itself after SCLAUDE_GATE_IDLE seconds with no connection open and
# none new, and the socket starts it again on the next one.
#
# Two sides, on two origins, from one process: the bot's (127.0.0.1:3001,
# funnel :8443) — the menu page, code-server, and the entry the bot's buttons
# open — and the features' (127.0.0.1:3002, funnel :10000). A browser keeps
# one origin's scripts away from another's, and a feature's page runs
# whatever the product loads, so it must not stand where initData is, or the
# menu that starts sessions on this machine. The entry checks initData on the
# bot's side and frames the features' side with a ticket
# (tg_webapp.sign_ticket), which buys a cookie of that side's own. The page
# itself stays on the bot's side: Telegram sends its events (the back
# button, the safe area) only to the origin the Mini App opened on. The two
# talk by postMessage, each answering only the other's origin.
#
# Cookies are not kept apart by port, so each side's cookie is sent to both:
# each side reads only its own, the bot's side refuses what the features' side
# makes the browser send (Sec-Fetch-Site same-site), and neither cookie is
# passed on to what stands behind the gate, or taken from what it answers.
import tg_webapp  # noqa: E402

GATE_PORT = int(os.environ.get("SCLAUDE_GATE_PORT") or 3001)
GATE_APP_PORT = int(os.environ.get("SCLAUDE_GATE_APP_PORT") or 3002)
# The port the funnel publishes the features' side on, on the same name: the
# entry page builds the address from its own host and this.
GATE_APP_PUBLIC = int(os.environ.get("SCLAUDE_GATE_APP_PUBLIC") or 10000)
# And the bot's, which the features' side answers to from inside its frame.
GATE_BOT_PUBLIC = int(os.environ.get("SCLAUDE_GATE_BOT_PUBLIC") or 8443)
GATE_UPSTREAM = int(os.environ.get("SCLAUDE_GATE_UPSTREAM") or PORT)
GATE_ENV = os.environ.get("SCLAUDE_GATE_ENV") or os.path.expanduser(
    "~/.config/keepawake/env")
GATE_IDLE = float(os.environ.get("SCLAUDE_GATE_IDLE") or 1800)
GATE_COOKIE = "sclaude_tg"
GATE_APP_COOKIE = "sclaude_tg_app"
GATE_COOKIES = (GATE_COOKIE, GATE_APP_COOKIE)
# The Mini App goes full screen, as close to an app of its own as Telegram
# allows. Telegram then floats its close and menu buttons over the top of the
# page; False keeps its header and only expands the sheet to full height.
GATE_FULLSCREEN = True
AUTH_BODY_LIMIT = 8192

GATE = {"token": "", "owner": 0, "open": 0, "last": 0.0}
# Tickets already used, by their value, until they would have run out anyway.
USED_TICKETS = {}


def gate_cookie(header, name=GATE_COOKIE):
    for part in header.split(";"):
        key, _, value = part.strip().partition("=")
        if key == name:
            return value.strip()
    return ""


def take_ticket(value):
    """True the first time a good ticket is shown, never again."""
    now = time.time()
    for used, until in list(USED_TICKETS.items()):
        if until <= now:
            del USED_TICKETS[used]
    expiry = tg_webapp.ticket_valid(value, GATE["token"])
    if not expiry or value in USED_TICKETS:
        return False
    USED_TICKETS[value] = expiry
    return True


# The Mini App's own frame. Telegram shows no address bar in a Mini App and has
# no way to turn one on, so the page the button opens draws one: a thin bar
# with back, reload, the address (editable) and a way out of the frame, and the
# feature in an iframe under it. Same origin, so the bar reads where the frame
# is, SPA navigations included (polled: pushState fires no event outside).
# The bar sits below Telegram's own floating buttons in full screen, from the
# safe-area insets telegram-web-app.js publishes as CSS variables.
# What a frame cannot hold — a provider's sign-in page that forbids framing —
# opens with ⤢, which leaves the frame for the bare page.
SHELL_STYLE = """
html,body{margin:0;height:100%;background:var(--tg-theme-bg-color,#fff);
font:14px system-ui,sans-serif;color:var(--tg-theme-text-color,#1c1917)}
#shell{display:flex;flex-direction:column;height:100%}
#bar{display:flex;gap:4px;align-items:center;padding:4px 6px;
padding-top:calc(4px + var(--tg-safe-area-inset-top,0px) + var(--tg-content-safe-area-inset-top,0px));
background:var(--tg-theme-secondary-bg-color,#f5f5f4);border-bottom:1px solid rgba(0,0,0,.12)}
#bar button{border:0;background:none;font-size:18px;padding:4px 6px;color:inherit}
#url{flex:1;min-width:0;border:0;border-radius:8px;padding:6px 8px;font:inherit;
background:var(--tg-theme-bg-color,#fff);color:inherit}
#frame{flex:1;border:0;width:100%}
#bar[hidden]{display:none}
#msg{padding:24px 16px}
"""


def js_string(value):
    """A JavaScript string literal safe inside <script>: json.dumps leaves
    "</script>" as it is, and the page's parser would end the script there."""
    return json.dumps(value).replace("<", "\\u003c").replace(">", "\\u003e")


# What a path of the gate's own (`p`) may hold: a code-server address and its
# query, nothing that could close a string or a tag.
GATE_PATH = re.compile(r"^[A-Za-z0-9/_.~%?=&+-]*$")


# The address bar over the frame, on either side: the page runs it once it
# may show the frame. remote, an origin, is a frame of the features' side
# inside the bot's page: the bar cannot look into it, so it learns where the
# frame is from what that side's page says (gate_shell), and asks it to
# reload or go; back is the page's own history, which holds the frame's.
SHELL_SCRIPT = """
// DIAG (temporary): what this page knows of Telegram, to the gate's journal.
function report(what) { try {
  const params = (window.Telegram && window.Telegram.WebView && window.Telegram.WebView.initParams) || {};
  navigator.sendBeacon('/__sclaude/diag', JSON.stringify({what: what, page: location.pathname,
    version: tg && tg.version, platform: tg && tg.platform, full: tg && tg.isFullscreen,
    keys: Object.keys(params).filter((k) => k !== 'tgWebAppData'), signed: !!params.tgWebAppData,
    hash: location.hash.length, history: history.length, frame: -1}));
} catch (e) {} }
function shell(start, remote) {
  msg.remove();
  document.getElementById('shell').hidden = false;
  const frame = document.getElementById('frame');
  const url = document.getElementById('url');
  const host = remote ? new URL(remote).host : location.host;
  let shown = '';
  const show = (w) => { if (w && w !== shown && document.activeElement !== url) {
    shown = w; url.value = host + w; } };
  // about:blank and error pages are not an address worth showing.
  const where = () => { if (remote) return shown || null;
    try { const l = frame.contentWindow.location;
      return l.protocol.startsWith('http') ? l.pathname + l.search + l.hash : null; }
    catch (e) { return null; } };
  const tell = (m) => frame.contentWindow.postMessage(m, remote);
  if (remote) {
    // Only where the frame is, from that frame, and only shown as text.
    window.addEventListener('message', (e) => {
      if (e.source === frame.contentWindow && e.origin === remote && e.data
          && e.data.sclaude === 'where' && typeof e.data.at === 'string') show(e.data.at); });
  } else setInterval(() => show(where()), 400);
  const back = () => { report('back'); remote ? history.back() : frame.contentWindow.history.back(); };
  document.getElementById('back').onclick = back;
  document.getElementById('reload').onclick = () => remote ? tell({sclaude: 'reload'})
    : frame.contentWindow.location.reload();
  document.getElementById('out').onclick = () => { location.href = (remote || '') + (where() || '/'); };
  url.onkeydown = (e) => { if (e.key !== 'Enter') return;
    let v = url.value.trim().replace(/^https?:\\/\\//, '');
    if (v.startsWith(host)) v = v.slice(host.length);
    if (!v.startsWith('/')) v = '/' + v;
    remote ? tell({sclaude: 'go', to: v}) : (frame.contentWindow.location.href = v); url.blur(); };
  if (tg && tg.isVersionAtLeast('6.1')) {
    tg.BackButton.show(); tg.BackButton.onClick(back);
  }
  // A feature's page may not take this page's place: a frame of another
  // origin can still send the whole Mini App elsewhere, to a page dressed
  // as the bot's. Everything else a product does in a frame stays allowed;
  // leaving the frame is the bar's ⤢, from this page.
  if (remote) frame.sandbox = 'allow-scripts allow-same-origin allow-forms allow-modals '
    + 'allow-popups allow-popups-to-escape-sandbox allow-downloads';
  frame.src = start;
  report('shell');
}
function view() {
  tg.ready();
  tg.expand();
  if (%(full)s && tg.isVersionAtLeast('8.0') && !tg.isFullscreen) { try { tg.requestFullscreen(); } catch (e) {} }
  if (tg.isVersionAtLeast('7.7')) tg.disableVerticalSwipes();
}
""" % {"full": "true" if GATE_FULLSCREEN else "false"}


def shell_page(title, script, telegram=True):
    """The address bar and its frame, hidden until script shows them."""
    return ("<!doctype html><html><head><meta charset=utf-8>"
            "<meta name=viewport content='width=device-width,initial-scale=1,viewport-fit=cover'>"
            "<title>%s</title><style>%s</style></head><body>"
            "<p id=msg>Opening %s…</p>"
            "<div id=shell hidden><div id=bar>"
            "<button id=back aria-label=Back>‹</button>"
            "<button id=reload aria-label=Reload>⟳</button>"
            "<input id=url inputmode=url autocapitalize=off autocorrect=off spellcheck=false>"
            "<button id=out aria-label='Open without the bar'>⤢</button>"
            "</div><iframe id=frame></iframe></div>"
            "%s<script>const tg = window.Telegram && window.Telegram.WebApp;\n"
            "const msg = document.getElementById('msg');%s%s</script></body></html>"
            % (html.escape(title), SHELL_STYLE, html.escape(title),
               "<script src='https://telegram.org/js/telegram-web-app.js'></script>"
               if telegram else "", SHELL_SCRIPT, script))


def gate_bootstrap(label, path=""):
    """The page the bot's button opens, on the bot's side: set the view up,
    prove who is looking, and show the address bar. code-server is in its
    frame from this side; a feature or its map from the features' side, which
    the frame enters with a ticket. The page itself stays here: a Telegram
    client sends its events (the back button, the safe area) to the origin
    the Mini App opened on, and a page that went to another got none."""
    script = """
const label = %(label)s, path = %(path)s;
if (!tg || !tg.initData) {
  msg.textContent = 'Open this from the bot: the phone button next to the feature.';
} else if (path.startsWith('/__code/')) {
  view();
  fetch('/__sclaude/tg/auth', {method: 'POST', body: tg.initData, credentials: 'same-origin'})
    .then((r) => r.ok ? shell(path) : (msg.textContent = 'The bot did not recognise you (' + r.status + ').'))
    .catch(() => { msg.textContent = 'The laptop did not answer.'; });
} else {
  view();
  fetch('/__sclaude/tg/ticket', {method: 'POST', body: tg.initData, credentials: 'same-origin'})
    .then((r) => r.ok ? r.text() : Promise.reject(r.status))
    .then((ticket) => {
      report('entry');
      const app = location.protocol + '//' + location.hostname + ':' + %(app)d;
      shell(app + '/__sclaude/enter?' + new URLSearchParams({t: ticket, f: label, p: path}), app);
    })
    .catch((e) => { msg.textContent = typeof e === 'number'
      ? 'The bot did not recognise you (' + e + ').' : 'The laptop did not answer.'; });
}
""" % {"label": js_string(label), "path": js_string(path), "app": GATE_APP_PUBLIC}
    return shell_page(label or ("code-server" if path else "Features"), script)


def gate_shell(label, path=""):
    """The features' side of the same page, for a browser with this side's
    cookie. In the bot's page it is only the feature's frame, with no bar of
    its own: it says where the feature is, and reloads or goes when that page
    asks — that page and no other. Loaded on its own, it draws its own bar.
    Never Telegram's script: in a frame it would talk to the bot's page."""
    script = """
const start = %(path)s || (%(label)s ? '/__sclaude/login?f=' + encodeURIComponent(%(label)s) : '/__sclaude/');
if (window.parent !== window) {
  const bot = location.protocol + '//' + location.hostname + ':' + %(bot)d;
  msg.remove();
  document.getElementById('shell').hidden = false;
  document.getElementById('bar').hidden = true;
  const frame = document.getElementById('frame');
  let shown = '';
  setInterval(() => { try { const l = frame.contentWindow.location;
    const w = l.pathname + l.search + l.hash;
    if (l.protocol.startsWith('http') && w !== shown) {
      shown = w; parent.postMessage({sclaude: 'where', at: w}, bot); } } catch (e) {} }, 400);
  window.addEventListener('message', (e) => {
    if (e.source !== parent || e.origin !== bot || !e.data) return;
    if (e.data.sclaude === 'reload') frame.contentWindow.location.reload();
    if (e.data.sclaude === 'go' && typeof e.data.to === 'string' && e.data.to.startsWith('/'))
      frame.contentWindow.location.href = e.data.to; });
  frame.src = start;
} else shell(start);
""" % {"label": js_string(label), "path": js_string(path), "bot": GATE_BOT_PUBLIC}
    return shell_page(label or "Features", script, telegram=False)


async def post_body(method, headers, reader):
    """A POST's body, small and whole, or None."""
    try:
        length = int(headers.get("content-length") or 0)
    except ValueError:
        length = -1
    if method != "POST" or not 0 < length <= AUTH_BODY_LIMIT:
        return None
    try:
        return await asyncio.wait_for(reader.readexactly(length), 15)
    except (asyncio.IncompleteReadError, asyncio.TimeoutError, ConnectionError):
        return None


# The bot's menu as a Mini App (an experiment): the Menu button by the input
# box opens /__sclaude/menu. The page has no cookie of its own: every call
# carries initData, checked here, which also brings the language Telegram
# reports. What the menu shows and does is keepawake's (webmenu.py), imported
# on the first call so that the plain proxy never loads the bot.
def webmenu():
    root = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
    if root not in sys.path:
        sys.path.insert(0, root)
    from keepawake import webmenu as module
    # keepawake logs what a press did; the gate's own lines go to stderr too.
    import logging
    if not logging.getLogger("keepawake").handlers:
        handler = logging.StreamHandler()
        handler.setFormatter(logging.Formatter("%(message)s"))
        logging.getLogger("keepawake").addHandler(handler)
        logging.getLogger("keepawake").setLevel(logging.INFO)
    return module


async def menu_api(body):
    try:
        call = json.loads(body.decode("utf-8", "replace"))
        init = str(call.get("init") or "")
        action, context = str(call.get("do") or ""), str(call.get("ctx") or "")
        label = str(call.get("label") or "")[:200]
        # The feature the page was opened on, from its topic.
        home = str(call.get("home") or "")[:200]
    except (ValueError, AttributeError):
        return respond("400 Bad Request", "")
    if not tg_webapp.verify_init_data(init, GATE["token"], GATE["owner"]):
        return respond("403 Forbidden", "")
    try:
        user = json.loads(dict(parse_qsl(init)).get("user") or "{}")
    except ValueError:
        user = {}
    # A press runs commands — `keepawake status`, systemctl — for seconds:
    # off the loop.
    out = await asyncio.to_thread(webmenu().answer, GATE["token"], GATE["owner"],
                                  user, action, context, int(time.time()), label, home)
    return respond("200 OK", json.dumps(out), kind="application/json; charset=utf-8")


MENU_STYLE = """
